name: {{ workflow_name | default(value="CI") }}

on:
  push:
    branches: [{{ branch | default(value="main") }}]
  pull_request:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout@v4
    - name: Build
      run: {{ build_command | default(value="cargo build --workspace") }}
    - name: Test
      run: {{ test_command | default(value="cargo test --workspace") }}
