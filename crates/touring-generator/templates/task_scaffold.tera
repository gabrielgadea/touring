# Task Scaffold — {{ task_id | default(value="task_id") }}
# Generated by Touring TaskScaffold (R14-S1 pattern)
# Intent: {{ intent | default(value="implement feature") }}
# Phase:  {{ phase | default(value="implementation") }}
#
# DAG structure: scout → implement → validate
# Subtasks are pre-wired with sequential dependencies for the TACO workflow.

task_id: {{ task_id | default(value="task_id") }}
intent:  {{ intent | default(value="implement feature") }}
phase:   {{ phase | default(value="implementation") }}

subtasks:
  - id: {{ task_id | default(value="task_id") }}::scout
    description: "scout: research context, blast radius, and wiring before changes"
    status: pending
    depends_on: []

  - id: {{ task_id | default(value="task_id") }}::implement
    description: "implement: apply changes with VGP verification and speculative validation"
    status: pending
    depends_on:
      - {{ task_id | default(value="task_id") }}::scout

  - id: {{ task_id | default(value="task_id") }}::validate
    description: "validate: cargo test + wiring orphans + memory store lesson"
    status: pending
    depends_on:
      - {{ task_id | default(value="task_id") }}::implement

