# Dockerfile: {{ image_name | default(value="app") }}
FROM {{ base_image | default(value="rust:1.75-slim") }} AS builder

WORKDIR /app
COPY . .
RUN cargo build --release -p {{ package_name | default(value="app") }}

FROM debian:bookworm-slim
COPY --from=builder /app/target/release/{{ binary_name | default(value="app") }} /usr/local/bin/
ENTRYPOINT ["/usr/local/bin/{{ binary_name | default(value="app") }}"]
