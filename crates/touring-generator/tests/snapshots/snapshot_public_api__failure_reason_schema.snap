      "additionalProperties": false,
      "required": [
        "SecretLeakDetected"
      ]
    },
    {
      "description": "Creating a pre-commit backup failed.",
      "type": "string",
      "const": "BackupFailure"
    },
    {
      "description": "A concurrent commit race was detected.",
      "type": "string",
      "const": "CommitRaceCondition"
