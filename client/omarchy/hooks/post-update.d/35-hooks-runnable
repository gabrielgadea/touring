#!/usr/bin/env bash
# 35-hooks-runnable — verify that every hook command registered in settings.json
# is executable after an Omarchy update. Part of OmarchyOS Agêntico (S-0.7, P0).
#
# The checker lives in ~/.local/bin/hooks_runnable.py on the installed Omarchy
# (installed during P3 from client/omarchy/bin/hooks_runnable.py).
# Exit 0 always — notifies on failure but never aborts the update.

set -euo pipefail

SETTINGS="${HOME}/.claude/settings.json"
CHECKER="${HOME}/.local/bin/hooks_runnable.py"

if [ ! -f "${CHECKER}" ] || [ ! -f "${SETTINGS}" ]; then
    exit 0
fi

if ! python3 "${CHECKER}" "${SETTINGS}" >/dev/null 2>&1; then
    MSG="Hooks Touring: comandos não executáveis em settings.json (rode hooks_runnable.py para detalhes)"
    command -v omarchy-notification-send >/dev/null 2>&1 && \
        omarchy-notification-send "${MSG}" || true
fi

exit 0
