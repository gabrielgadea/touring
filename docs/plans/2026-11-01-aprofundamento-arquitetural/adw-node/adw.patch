+# ── template references: ONE grammar ──────────────────────────────────────────
+# `{{nodes.X[.field]}}` / `{{vars.k}}` is read by the runtime resolver, by the
+# fragment namespacer, by the data-graph lints and by the sandbox-text lint. Until
+# 2026-11 each had its own regex (or a bare `f"nodes.{name}" in text`), and they
+# accepted four different languages: the lint saw `{{nodes.X.full_ref}}` as a node
+# called `X.full_ref`, so a node consumed only through `full_ref`/`facts` read as
+# dead weight; and `nodes.rev` matched inside `nodes.review`. Every reader now goes
+# through `REF_RE` + `parse_node_ref`; the runtime semantics below are the ones the
+# runner actually executes.
+REF_RE = re.compile(r"\{\{(nodes|vars)\.([\w.-]+?)\}\}")
+#: The three fields Law L4 promises as inter-node context. Until 2026-08-20 the resolver
+#: silently DROPPED the suffix and always returned `summary`, so `{{nodes.X.full_ref}}`
+#: rendered the truncated summary instead of the path to the whole output — two thirds of
+#: the contract were unreachable from any template.
+#:
+#: Measured cost: `critic-panel`'s quorum counts `^VERDICT=` over `{{nodes.panel.summary}}`,
+#: and a critic emits its verdict at the END of its report. With SUMMARY_LIMIT at 2000
+#: bytes and 14 718 omitted, the quorum saw ZERO verdicts and escalated — while all three
+#: critics had returned REJECT. A panel that can never count is not a panel.
+#:
+#: Omitted, the field is `summary` — the dense inline default of Law L4. An unknown
+#: suffix is part of the node NAME, not a field, so a node called `a.b` keeps resolving.
+RESULT_FIELDS = ("summary", "full_ref", "omitted_bytes")
+FACTS_SEP = ".facts."
+
+
+@dataclass(frozen=True)
+class NodeRef:
+    """One parsed `{{nodes.<body>}}`: which node, which of its result fields."""
+
+    node: str
+    field: str = "summary"  # a RESULT_FIELDS member, or "facts"
+    fact: str = ""  # the fact key, when field == "facts"
+
+
+def parse_node_ref(body: str) -> NodeRef:
+    """`X`, `X.summary`, `X.full_ref`, `X.omitted_bytes`, `X.facts.k` → NodeRef."""
+    if FACTS_SEP in body:
+        # W4 S-4.4 — {{nodes.X.facts.chave}}: o fato de um probe, endereçável a
+        # jusante (E3 ganha o endereço que faltava).
+        node, fact = body.split(FACTS_SEP, 1)
+        return NodeRef(node, "facts", fact)
+    for field_name in RESULT_FIELDS:
+        if body.endswith(f".{field_name}"):
+            return NodeRef(body[: -len(field_name) - 1], field_name)
+    return NodeRef(body)
+
+
+def node_refs(text: str) -> list[NodeRef]:
+    """Every node reference in ``text``, in order — the lints' view of the runtime."""
+    return [parse_node_ref(body) for kind, body in REF_RE.findall(text) if kind == "nodes"]
+
+
