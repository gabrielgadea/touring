+# ── node schema: what a [node.X] table may say, in ONE place ──────────────────
+# `Node.raw` is the TOML table verbatim, so the node's interface used to be
+# implicit: ~180 `.raw[...]` reads spread over ~65 functions, no lint for a key
+# nobody reads, and a typo (or a field the runner does not implement) was a silent
+# no-op. Measured 2026-11-02 over the shipped libraries: `env` sits in
+# `skilling-pack` (a code node that sets RECURRENCE for its own command) and the
+# runner has never read it — the gate always saw RECURRENCE unset and answered
+# "one-off". This table is that interface. `schema_findings` (lint) derives
+# from it; `test_node_schema_covers_every_key_the_runtime_reads` ties it to the
+# code, so a key read at run time and absent here fails the build.
+
+
+@dataclass(frozen=True)
+class NodeField:
+    """One key of a `[node.X]` table: its TOML kind(s) and who honours it."""
+
+    kinds: tuple[type, ...]
+    #: node types that read it; empty = every type.
+    types: frozenset[str] = frozenset()
+    #: element type, for list values.
+    of: type | None = None
+    #: closed vocabulary — only where no dedicated lint already owns it.
+    choices: tuple[str, ...] = ()
+    #: a dedicated lint already validates this key's shape/placement; the table
+    #: only vouches that the key EXISTS (never a second message for one defect).
+    dedicated: bool = False
+    #: accepted but not honoured (yet): the warning says why.
+    reserved: str = ""
+    #: refused: not a field, and the message names the one that is.
+    refused: str = ""
+
+
+def _field(kinds, *types: str, of: type | None = None, choices: tuple[str, ...] = (),
+           dedicated: bool = False, reserved: str = "", refused: str = "") -> NodeField:
+    kinds = tuple(kinds) if isinstance(kinds, (tuple, list)) else (kinds,)
+    return NodeField(kinds, frozenset(types), of, choices, dedicated, reserved, refused)
+
+
+_EXEC = ("code", "gate", "probe", "control")  # nodes that run `command`
+NODE_FIELDS: dict[str, NodeField] = {
+    # identity and edges (every node; targets are checked by `_lint_node`)
+    "type": _field(str, dedicated=True),
+    **{edge: _field(str, dedicated=True) for edge in ("on_pass", "on_fail", "on_dry")},
+    "on_escalate": _field(str, "gate", "agent", dedicated=True),
+    **{edge: _field(str, "loop", dedicated=True)
+       for edge in ("on_stable", "on_covered", "on_calibrated")},
+    # any node
+    "readonly": _field(bool),
+    "budget_tokens": _field(int),
+    "max_retries": _field(int),
+    # code / gate / probe / control
+    "command": _field(list, *_EXEC, of=str),
+    "timeout_ms": _field(int, *_EXEC, "agent"),
+    "retries": _field(int, "code", "gate", "probe", "agent"),
+    "idempotent": _field(bool, "code", "gate"),
+    "sandbox": _field(bool, "code", "gate", "probe"),
+    "verdict_contract": _field(bool, "gate"),
+    # truthy waives the control lint; the shipped flows pass the REASON as a string.
+    "control_waived": _field((bool, str), "gate"),
+    "stagnation_rounds": _field(int, "gate"),
+    "good_input": _field(str, "control", dedicated=True),
+    "bad_input": _field(str, "control", dedicated=True),
+    # agent
+    "driver": _field(str, "agent", dedicated=True),
+    "prompt": _field(str, "agent"),
+    "tier": _field(str, "agent"),
+    "allowed_tools": _field(list, "agent", of=str),
+    "tools": _field(str, "agent", dedicated=True),
+    "skill": _field((str, list), "agent", of=str),
+    "budget_usd": _field((int, float), "agent"),
+    "permission_mode": _field(str, "agent"),
+    "session": _field(str, "agent", choices=("fresh", "resume_on_fail")),
+    "session_persistence": _field(bool, "agent", dedicated=True),
+    "mcp": _field(str, "agent", dedicated=True),
+    "add_dirs": _field(list, "agent", of=str),
+    "persona": _field(dict, "agent", dedicated=True),
+    "must_read": _field(list, "agent", dedicated=True),
+    "findings_contract": _field(bool, "agent", dedicated=True),
+    "max_major": _field(int, "agent", dedicated=True),
+    "triage_of": _field(str, "agent", dedicated=True),
+    "output_schema": _field(dict, "agent", dedicated=True),
+    "max_turns": _field(int, "agent", reserved="documented in the module header but the "
+                        "headless driver does not pass it to `claude -p` yet"),
+    # loop
+    "body": _field(str, "loop", dedicated=True),
+    "max_iters": _field(int, "loop", dedicated=True),
+    "predicate": _field(str, "loop", dedicated=True),
+    "churn_limit": _field(int, "loop", dedicated=True),
+    "dry_rounds": _field(int, "loop"),
+    "stable_rounds": _field(int, "loop"),
+    "min_discovered": _field(int, "loop"),
+    # human
+    "message": _field(str, "human"),
+    "zte": _field(bool, "human"),
+    "zte_warmup": _field(int, "human"),
+    # parallel
+    "branches": _field((list, str), "parallel", dedicated=True),
+    "template": _field((str, dict), "parallel", dedicated=True),
+    "max_branches": _field(int, "parallel", dedicated=True),
+    "merge": _field(str, "parallel", dedicated=True),
+    "on_branch_fail": _field(str, "parallel", dedicated=True),
+    # `policy` is the cartografia's third field for the same decision. Two fields
+    # meaning one thing is how a spec ends up contradicting itself (its own example
+    # pairs policy = "quorum:2" with on_branch_fail = "all"), so it is refused with
+    # the name that owns the semantics rather than silently ignored.
+    "policy": _field(str, "parallel", dedicated=True, refused=(
+        "`policy` is not a field — the pass condition is `on_branch_fail` "
+        "(all|any|ignore|best_effort|quorum:N)")),
+}
+
+_KIND_NAMES = {str: "a string", int: "an integer", float: "a number", bool: "a boolean",
+               list: "a list", dict: "a table"}
+
+
+def _kind_ok(value, kinds: tuple[type, ...]) -> bool:
+    """TOML kinds, with the Python trap closed: `True` is an `int` to isinstance, but
+    `retries = true` is not a retry count. (Numbers declare `(int, float)`.)"""
+    if isinstance(value, bool):
+        return bool in kinds
+    return isinstance(value, kinds)
+
+
+def _kind_label(field_def: NodeField) -> str:
+    label = " or ".join(_KIND_NAMES[k] for k in field_def.kinds)
+    return f"{label} of {field_def.of.__name__}" if field_def.of else label
+
+
+def _unknown_key(node: Node, key: str) -> str:
+    close = difflib.get_close_matches(key, NODE_FIELDS, n=1, cutoff=0.75)
+    hint = f" — did you mean `{close[0]}`?" if close else ""
+    return (f"node `{node.name}`: unknown key `{key}`{hint} — the runner never reads it, "
+            f"so it silently does nothing")
+
+
+def _field_findings(node: Node, key: str, value, field_def: NodeField) -> tuple[list[str], list[str]]:
+    """Errors/warnings for one KNOWN key of one node."""
+    if field_def.refused:
+        return [f"{node.type} `{node.name}`: {field_def.refused}"], []
+    warnings = ([f"node `{node.name}`: `{key}` is accepted but not honoured yet — "
+                 f"{field_def.reserved}"] if field_def.reserved else [])
+    if field_def.dedicated:
+        return [], warnings
+    if field_def.types and node.type not in field_def.types:
+        return [], warnings + [f"node `{node.name}`: `{key}` has no effect on a `{node.type}` "
+                               f"node (read by: {', '.join(sorted(field_def.types))})"]
+    elements_ok = not (field_def.of and isinstance(value, list)) or all(
+        isinstance(v, field_def.of) for v in value)
+    if not (_kind_ok(value, field_def.kinds) and elements_ok):
+        return [f"node `{node.name}`: `{key}` must be {_kind_label(field_def)} (got {value!r})"], warnings
+    if field_def.choices and value not in field_def.choices:
+        return [f"node `{node.name}`: `{key}` = {value!r} — want one of "
+                f"{list(field_def.choices)}"], warnings
+    return [], warnings
+
+
+def schema_findings(node: Node) -> tuple[list[str], list[str]]:
+    """(errors, warnings) for the KEYS of one node table — not for what they mean.
+
+    · unknown key → error (+ did-you-mean): the runner never reads it;
+    · wrong TOML kind / outside the closed vocabulary → error;
+    · a key another node type reads → warning (it does nothing here);
+    · a reserved key → warning (accepted, not honoured)."""
+    errors: list[str] = []
+    warnings: list[str] = []
+    for key, value in node.raw.items():
+        field_def = NODE_FIELDS.get(key)
+        if field_def is None:
+            errors.append(_unknown_key(node, key))
+            continue
+        found_errors, found_warnings = _field_findings(node, key, value, field_def)
+        errors += found_errors
+        warnings += found_warnings
+    return errors, warnings
+
+
