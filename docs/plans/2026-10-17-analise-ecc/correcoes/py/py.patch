+    def _paren(self) -> None:
+        """`(` / `)` end a command; `((...))` is an arithmetic command, one opaque word: its `<<` is a shift, not a
+        heredoc that would swallow the lines after it."""
+        s, i = self.s, self.i
+        self._end_word()
+        if s.startswith("((", i):
+            k = _match_paren(s, i)
+            self._add(s[i : k + 1], s[i : k + 1])
+            self._end_word()
+            self.i = k + 1
+            return
+        self._end_seg(False)
+        self.i += 1
