+    "touring run python": "touring run --lang python --code \"import os; os.system('git reset --hard')\"",
+    # xargs: stdin supplies the arguments
+    "xargs bare subcommand": "echo --hard | xargs git reset",
+    "xargs clean": "ls | xargs git clean",
