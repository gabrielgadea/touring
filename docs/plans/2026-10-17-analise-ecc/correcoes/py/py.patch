+    # scanners
+    def run(self) -> _Parsed:
+        s, n = self.s, self.n
+        while self.i < n:
+            c = s[self.i]
+            if c == "\\":
+                self._escape()
+            elif c == "'":
+                self._single()
+            elif c == '"':
+                self._double()
+            elif c == "`":
