+def manifesto_toml(path: Path, base: Path) -> Path:
+    path.write_text(f'''
+versao = 1
+base = "{base}"
+
+[censo]
+diretorios = ["."]
+extensoes = [".jsonl", ".log"]
+
+[[journal]]
+id = "trace"
+caminho = "trace.jsonl"
+tipo = "jsonl"
+escritores = ["w.rs"]
+leitores = [ {{ arquivo = "r.py", janela_dias = 2, verificada = true }} ]
+retencao_dias = 30
+expira = "arquivar"
+ts = {{ campo = "ts_ms", unidade = "epoch_ms" }}
+rollup = {{ agrupar_por = ["hook", "route"], somar = ["elapsed_ms"] }}
+''', encoding="utf-8")
+    return path
+
