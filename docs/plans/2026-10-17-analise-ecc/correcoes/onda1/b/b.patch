+# Manifesto de journals do runtime (`~/.claude/touring`) — decisão N6, 17/10/2026.
+#
+# Cada journal declara: caminho, tipo, ESCRITORES, LEITORES (com a janela que cada um precisa),
+# retenção, política de expiração e rollup. `scripts/journal_gc.py` poda SÓ o que este manifesto
+# prova que ninguém precisa; `--verificar` confere o manifesto contra o código que ele nomeia.
+#
+# Janela de leitor (`janela_dias`):
+#   N     o leitor lê só os últimos N dias; a retenção do journal precisa ser >= N
+#   0     o leitor recebe o caminho por parâmetro (--trace PATH) e roda sobre cópia/arquivo:
+#         não exige histórico no arquivo vivo
+#   "toda"  o leitor lê o ARQUIVO INTEIRO (ou ninguém verificou). Bloqueia a poda — fail-closed.
+#           Desbloquear é mudança no leitor (janelar, ou ler rollup + recente), nunca no manifesto.
+# `verificada = true` só onde a janela foi lida no código; o resto é tratado como "toda".
+#
+# Expiração: `arquivar` move as linhas vencidas para `arquivo/<nome>.<AAAA-MM>.gz` (gzip, um
+# membro por poda) e grava o rollup antes; `apagar` só descarta (permitido sem rollup apenas
+# quando NINGUÉM lê o journal). Dias são UTC; timestamps sem offset agrupam pela data literal.
+#
+# ACHADOS DA PRIMEIRA PASSADA (18/10/2026):
+#   * `oom_slice_gate.jsonl` (142 linhas) NÃO tem escritor localizável no repo nem em
+#     ~/.claude/{hooks,tools,skills}: fica FORA do manifesto de propósito — o censo o acusa como
+#     `sem_manifesto` até alguém apontar quem o grava.
+#   * Escritores sem leitor (REGRA #0): hooks_complement, compactions, daemon_crash, memwatch,
+#     scope_shield, disk_watch, disk_cleanup, context_check, hw_slot, cpu_health, daemon_stderr,
+#     logs_pontuais.
+#   * Deriva de nome: `scripts/update-touring` rotaciona `daemon-stderr.log` (hífen), o daemon
+#     grava `daemon.stderr.log` (ponto) — a proteção de 10 MiB nunca alcança o arquivo real.
+#   * Leitores de arquivo inteiro: touring-code/journal.rs lê o run_journal.jsonl TODO (o KPI
+#     code_mode_adherence é sobre o acervo inteiro), e kpi.rs lê o run_subcalls.jsonl TODO.
+#   * `activity.jsonl` global está parado desde ~27/08 (o escritor atual grava em
+#     `<projeto>/.claude/touring/`); a cópia global é resíduo.
+
+versao = 1
+base = "~/.claude/touring"
+
+[censo]
+diretorios = [".", "logs"]
+extensoes = [".jsonl", ".log"]
