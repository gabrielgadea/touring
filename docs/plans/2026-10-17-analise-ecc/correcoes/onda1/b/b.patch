+  { arquivo = "scripts/r3_latency_by_day.py", janela_dias = 0, verificada = true, nota = "--trace PATH: roda sobre cópia ou arquivo descomprimido" },
+  { arquivo = "scripts/r3_prove_delivery.py", janela_dias = 0, verificada = true, nota = "--trace PATH; --lookback-days é relativo a --on-ts, sobre o arquivo passado" },
+]
+retencao_dias = 30
+expira = "arquivar"
+ts = { campo = "ts_ms", unidade = "epoch_ms" }
+rollup = { agrupar_por = ["hook", "route", "exit_reason", "stdin_state"], somar = ["elapsed_ms", "stdin_bytes"] }
