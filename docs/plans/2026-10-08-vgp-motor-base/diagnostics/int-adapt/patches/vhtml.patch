+++ b/crates/touring-code/src/vgp/lang/html/ancora.rs
@@ -0,0 +1,303 @@
+//! Class `ancora` (VL0 §4): an id the document refers to that no element carries, and an id
+//! declared twice.
+//!
+//! The references are the ones the HTML spec resolves INSIDE the document: `<a href="#x">` /
+//! `<area>` / SVG `<use href="#x">` (fragment navigation: an element with that `id`, or an `<a
+//! name>`), `<label for="x">`, and the id lists of `aria-labelledby` / `aria-describedby`. The
+//! inline-script lookups (`getElementById`, `querySelector('#x')`) live in `script.rs`.
+//!
+//! "Missing" is a claim about the whole page, so the set of ids that exist is deliberately generous:
+//! the parse tree's ids, a lexical `id=` scan of the source (it also sees what an error region or a
+//! comment hides), `<a name>`, ids inside `<template>`, and everything a script may create. A page
+//! whose ids may live elsewhere — a template that extends or includes another, a fragment with no
+//! `<html>`/`<body>` — is not measured at all.
+
+use std::collections::{HashMap, HashSet};
+
+use super::Saida;
+use super::documento::{Documento, Elemento};
+use super::script::AnaliseScripts;
+use super::texto::{decodificar_percentual, ids_no_texto, mais_proximos, tem_template};
+use crate::vgp::Finding;
+use crate::vgp::politica::Alvo;
+
+/// Constructs that pull markup (and ids) from another file: the ids a page refers to may be
+/// declared there.
+const COMPOSICAO: &[&str] = &[
+    "{% extends",
+    "{%- extends",
+    "{% include",
+    "{%- include",
+    "{% import",
+    "{{>",
+    "{{> ",
+    "{{#extend",
+    "<!--#include",
+    "<?php",
+    "<%@",
+    "<jsp:include",
+    "<ng-include",
+    "<ui:include",
+];
+
+/// A reference to an id of the document.
+struct Referencia {
+    id: String,
+    /// 1-based line of the attribute.
+    linha: usize,
+    /// `<a href="#x">`, `<label for>`…
+    origem: String,
+}
+
+/// Why the anchors of this document cannot be judged, if they cannot.
+fn nao_mensuravel(doc: &Documento, fonte: &str) -> Option<String> {
+    if let Some(m) = COMPOSICAO.iter().find(|m| fonte.contains(**m)) {
+        return Some(format!(
+            "documento com `{m}`: os ids referenciados podem estar em outro arquivo"
+        ));
+    }
+    if doc.ids.keys().any(|id| tem_template(id)) {
+        return Some("ids gerados por template: âncoras não medidas".to_string());
+    }
+    if !doc.eh_pagina {
+        return Some(
+            "fragmento HTML (sem `<html>`, `<head>`, `<body>` nem doctype): \
+             os ids podem estar na página hospedeira"
+                .to_string(),
+        );
+    }
+    None
+}
+
+/// The ids that exist or may exist at run time.
+pub(super) fn ids_presentes<'a>(
+    doc: &'a Documento,
+    fonte: &'a str,
+    scripts: &'a AnaliseScripts,
+) -> HashSet<&'a str> {
+    let mut presentes: HashSet<&str> = HashSet::new();
+    presentes.extend(doc.ids.keys().map(String::as_str));
+    presentes.extend(doc.ids_em_template.iter().map(String::as_str));
+    presentes.extend(ids_no_texto(fonte));
+    presentes.extend(scripts.criados.iter().map(String::as_str));
+    presentes.extend(
+        doc.elementos
+            .iter()
+            .filter(|e| e.tag == "a")
+            .filter_map(|e| e.valor("name")),
+    );
+    presentes
+}
+
+/// Report the missing ids and the duplicated ones.
+pub(super) fn verificar(
+    doc: &Documento,
+    fonte: &str,
+    scripts: &AnaliseScripts,
+    presentes: &HashSet<&str>,
+    saida: &mut Saida,
+) {
+    let (referencias, dinamicas) = referencias(doc);
+    if dinamicas > 0 {
+        saida.nao_medido(format!(
+            "{dinamicas} referência(s) a id com valor de template não medida(s)"
+        ));
+    }
+    let ha_duplicados = doc.ids.values().any(|ls| ls.len() > 1);
+    if (!referencias.is_empty() || ha_duplicados)
+        && let Some(motivo) = nao_mensuravel(doc, fonte)
+    {
+        saida.nao_medido(motivo);
+        return;
+    }
+    // o disco decide: o id é do PROJETO e não existe; um script da página (externo, dinâmico ou
+    // ilegível) pode criá-lo em tempo de execução, e aí a dúvida é de verdade (`Incerto`)
+    let alvo = if scripts.dinamico || doc.tem_script_externo() {
+        Alvo::Incerto
+    } else {
+        Alvo::Projeto
+    };
+    let mut ordenados: Option<Vec<&str>> = None;
+    for (id, grupo) in agrupar(&referencias) {
+        let existe = |i: &str| presentes.contains(i);
+        if existe(id) || decodificar_percentual(id).is_some_and(|d| existe(&d)) {
+            continue;
+        }
+        let candidatos = ordenados.get_or_insert_with(|| {
+            let mut v: Vec<&str> = presentes.iter().copied().collect();
+            v.sort_unstable();
+            v
+        });
+        saida.achado(ausente(id, &grupo, alvo, candidatos));
+    }
+    duplicados(doc, saida);
+}
+
+/// A candidate reference found on an element, before it is classified.
+struct Candidato<'a> {
+    token: &'a str,
+    /// Attribute name (`href`, `for`, `aria-labelledby`…).
+    atributo: &'a str,
+    linha: usize,
+    origem: String,
+}
+
+/// `href="#x"` of `<a>`/`<area>`/`<use>`, `for="x"` of `<label>`, the ids of `aria-labelledby` and
+/// `aria-describedby` — plus how many carried a template marker (skipped).
+fn referencias(doc: &Documento) -> (Vec<Referencia>, usize) {
+    let mut out = Vec::new();
+    let mut dinamicas = 0;
+    let base_externa = tem_base_externa(doc);
+    for el in &doc.elementos {
+        for c in candidatos_do_elemento(el, base_externa) {
+            match classificar(&c) {
+                Token::Id => out.push(Referencia {
+                    id: c.token.to_string(),
+                    linha: c.linha,
+                    origem: c.origem,
+                }),
+                Token::Dinamico => dinamicas += 1,
+                Token::Ignorado => {}
+            }
+        }
+    }
+    (out, dinamicas)
+}
+
+fn candidatos_do_elemento(el: &Elemento, base_externa: bool) -> Vec<Candidato<'_>> {
+    let mut out = Vec::new();
+    if !base_externa && matches!(el.tag.as_str(), "a" | "area" | "use") {
+        for nome in ["href", "xlink:href"] {
+            let Some(a) = el.atributo(nome) else { continue };
+            let fragmento = a.valor.as_deref().and_then(|v| v.trim().strip_prefix('#'));
+            if let Some(token) = fragmento {
+                out.push(Candidato {
+                    token,
+                    atributo: nome,
+                    linha: a.linha,
+                    origem: format!("<{} {nome}=\"#…\">", el.tag),
+                });
+            }
+        }
+    }
+    if el.tag == "label"
+        && let Some(a) = el.atributo("for")
+        && let Some(v) = a.valor.as_deref()
+    {
+        out.push(Candidato {
+            token: v.trim(),
+            atributo: "for",
+            linha: a.linha,
+            origem: "<label for>".to_string(),
+        });
+    }
+    for nome in ["aria-labelledby", "aria-describedby"] {
+        let Some(a) = el.atributo(nome) else { continue };
+        for token in a.valor.as_deref().unwrap_or("").split_ascii_whitespace() {
+            out.push(Candidato {
+                token,
+                atributo: nome,
+                linha: a.linha,
+                origem: nome.to_string(),
+            });
+        }
+    }
+    out
+}
+
+/// What a fragment or id token is.
+enum Token {
+    Id,
+    Dinamico,
+    Ignorado,
+}
+
+/// `#` / `#top` / `#!/route` / `#/route` / `#:~:text=…` navigate somewhere that is not an id.
+fn classificar(c: &Candidato) -> Token {
+    if c.token.is_empty() {
+        return Token::Ignorado;
+    }
+    if tem_template(c.token) {
+        return Token::Dinamico;
+    }
+    let navegacao = c.atributo.ends_with("href");
+    let especial = c.token.eq_ignore_ascii_case("top")
+        || c.token.starts_with(['!', '/'])
+        || c.token.contains(":~:");
+    if navegacao && especial {
+        Token::Ignorado
+    } else {
+        Token::Id
+    }
+}
+
+/// With a `<base href>` that is not `#…`, `href="#x"` resolves against the base — another document.
+fn tem_base_externa(doc: &Documento) -> bool {
+    doc.elementos
+        .iter()
+        .any(|e| e.tag == "base" && e.valor("href").is_some_and(|v| !v.trim().is_empty()))
+}
+
+/// Group the references by id, in order of first appearance.
+fn agrupar(referencias: &[Referencia]) -> Vec<(&str, Vec<&Referencia>)> {
+    let mut indice: HashMap<&str, usize> = HashMap::new();
+    let mut grupos: Vec<(&str, Vec<&Referencia>)> = Vec::new();
+    for r in referencias {
+        let i = *indice.entry(r.id.as_str()).or_insert_with(|| {
+            grupos.push((r.id.as_str(), Vec::new()));
+            grupos.len() - 1
+        });
+        grupos[i].1.push(r);
+    }
+    grupos
+}
+
+/// `candidatos` is the sorted list of ids that exist (sorted so the suggestions are deterministic).
+/// `alvo` is `Projeto` when the disk decides (the id is the project's and is absent) and
+/// `Incerto` when a script of the page may create it at run time — which the suggestion says.
+/// Whether this class may ever `deny` is the POLICY's call (`CLASSES_CONSULTIVAS`), not a label.
+fn ausente(id: &str, grupo: &[&Referencia], alvo: Alvo, candidatos: &[&str]) -> Finding {
+    let primeira = grupo[0];
+    let reais = mais_proximos(id, candidatos.iter().copied(), 5);
+    let mut sugestao = format!(
+        "id `{id}` ausente no documento (referenciado por {})",
+        primeira.origem
+    );
+    if grupo.len() > 1 {
+        sugestao.push_str(&format!(" e por mais {} referência(s)", grupo.len() - 1));
+    }
+    if alvo == Alvo::Incerto {
+        sugestao.push_str(
+            "; um script da página (externo ou dinâmico) pode criá-lo em tempo de execução",
+        );
+    }
+    if let Some(proximo) = reais.first() {
+        sugestao.push_str(&format!(". Você quis dizer `{proximo}`?"));
+    }
+    Finding::candidato("ancora", id, primeira.linha, alvo, sugestao, reais)
+}
+
+/// One finding per id that two elements carry (the second occurrence's line). `Incerto`: a
+/// duplicate is a lint, never an error the motor may deny.
+fn duplicados(doc: &Documento, saida: &mut Saida) {
+    let mut repetidos: Vec<(&String, &Vec<usize>)> =
+        doc.ids.iter().filter(|(_, ls)| ls.len() > 1).collect();
+    repetidos.sort_by_key(|(id, ls)| (ls[0], id.as_str()));
+    for (id, linhas) in repetidos {
+        let onde: Vec<String> = linhas.iter().take(4).map(|l| l.to_string()).collect();
+        saida.achado(Finding::candidato(
+            "ancora",
+            id,
+            linhas[1],
+            Alvo::Incerto,
+            format!(
+                "id `{id}` duplicado: {} elementos o declaram (linhas {}{}); só o primeiro é \
+                 alvo de âncora, de `label for` e de `getElementById`",
+                linhas.len(),
+                onde.join(", "),
+                if linhas.len() > 4 { ", …" } else { "" }
+            ),
+            Vec::new(),
+        ));
+    }
+}
diff --git a/crates/touring-code/src/vgp/lang/html/documento.rs b/crates/touring-code/src/vgp/lang/html/documento.rs
new file mode 100644
index 00000000..8e716b86
--- /dev/null
+++ b/crates/touring-code/src/vgp/lang/html/documento.rs
@@ -0,0 +1,232 @@
+//! What the html adapter reads out of the parse tree, once: every start tag with its attributes
+//! (names lowercased, character references decoded), the inline script bodies, and the ids.
+//!
+//! Grammar (`tree-sitter-html` 0.23.2, `src/grammar.json`): `start_tag` / `self_closing_tag` hold a
+//! `tag_name` and `attribute`s; an `attribute` is an `attribute_name` plus, optionally, an
+//! `attribute_value` or a `quoted_attribute_value` (which wraps an `attribute_value`, absent when
+//! the quotes are empty). `<script>` / `<style>` bodies are `raw_text` children of
+//! `script_element` / `style_element`. The grammar declares no fields.
+
+use std::collections::{HashMap, HashSet};
+
+use tree_sitter::{Node, Tree};
+
+use super::texto::decodificar_entidades;
+
+/// One attribute of a start tag.
+pub(super) struct Atributo {
+    /// Lowercased name (`href`, `xlink:href`, `aria-labelledby`…).
+    pub nome: String,
+    /// Value with character references decoded; `None` for a bare attribute (`<input disabled>`).
+    pub valor: Option<String>,
+    /// 1-based line of the attribute.
+    pub linha: usize,
+}
+
+/// One start tag (or self-closing tag).
+pub(super) struct Elemento {
+    /// Lowercased tag name.
+    pub tag: String,
+    pub atributos: Vec<Atributo>,
+    /// 1-based line of the tag.
+    pub linha: usize,
+}
+
+impl Elemento {
+    /// The attribute called `nome` (already lowercase), if the tag has it.
+    pub fn atributo(&self, nome: &str) -> Option<&Atributo> {
+        self.atributos.iter().find(|a| a.nome == nome)
+    }
+
+    /// The value of the attribute called `nome`, if it has one.
+    pub fn valor(&self, nome: &str) -> Option<&str> {
+        self.atributo(nome).and_then(|a| a.valor.as_deref())
+    }
+}
+
+/// The body of an inline `<script>` (one with no `src` still has its element in `elementos`).
+pub(super) struct ScriptInline {
+    /// Index of the `<script>` start tag in [`Documento::elementos`].
+    pub elemento: usize,
+    pub texto: String,
+    /// 0-based line of the first byte of the body.
+    pub linha_inicial: usize,
+}
+
+/// Everything the checks need from one parsed document.
+pub(super) struct Documento {
+    pub elementos: Vec<Elemento>,
+    pub scripts: Vec<ScriptInline>,
+    /// `id` value → lines of the elements that carry it (more than one = a duplicate).
+    pub ids: HashMap<String, Vec<usize>>,
+    /// Ids of elements inside a `<template>`: inert content, outside the duplicate check but a
+    /// valid target once instantiated.
+    pub ids_em_template: HashSet<String>,
+    /// The tree has a MISSING node or an ERROR that swallowed markup (`<`): part of the tags may
+    /// not have been read. An ERROR made of text only — a bare `>` in `a -> b`, which the grammar's
+    /// `text` token excludes — leaves every element intact and does not count (measured: 1 797 of
+    /// the 2 467 documents with a tree error in the analise tree).
+    pub tem_erro: bool,
+    /// The document has `<html>`, `<head>`, `<body>` or a doctype — it is a page, not a fragment.
+    pub eh_pagina: bool,
+}
+
+impl Documento {
+    /// Walk the tree once (iteratively — a deeply nested document must not overflow the stack).
+    pub fn ler(fonte: &str, tree: &Tree) -> Self {
+        let mut doc = Self {
+            elementos: Vec::new(),
+            scripts: Vec::new(),
+            ids: HashMap::new(),
+            ids_em_template: HashSet::new(),
+            tem_erro: false,
+            eh_pagina: false,
+        };
+        let mut cur = tree.walk();
+        loop {
+            let no = cur.node();
+            if !doc.tem_erro && erro_que_esconde_marcacao(fonte, no) {
+                doc.tem_erro = true;
+            }
+            match no.kind() {
+                "start_tag" | "self_closing_tag" if !no.is_missing() => doc.elemento(fonte, no),
+                "raw_text" => doc.script(fonte, no),
+                "doctype" => doc.eh_pagina = true,
+                _ => {}
+            }
+            if cur.goto_first_child() {
+                continue;
+            }
+            while !cur.goto_next_sibling() {
+                if !cur.goto_parent() {
+                    return doc;
+                }
+            }
+        }
+    }
+
+    fn elemento(&mut self, fonte: &str, no: Node) {
+        let mut tag = String::new();
+        let mut atributos = Vec::new();
+        let mut c = no.walk();
+        for filho in no.children(&mut c) {
+            match filho.kind() {
+                "tag_name" => tag = texto(fonte, filho).to_ascii_lowercase(),
+                "attribute" => atributos.extend(atributo(fonte, filho)),
+                _ => {}
+            }
+        }
+        if tag.is_empty() {
+            return;
+        }
+        let linha = no.start_position().row + 1;
+        if matches!(tag.as_str(), "html" | "head" | "body") {
+            self.eh_pagina = true;
+        }
+        self.registrar_id(fonte, no, &atributos);
+        self.elementos.push(Elemento {
+            tag,
+            atributos,
+            linha,
+        });
+    }
+
+    /// Record the `id` of a start tag: live ids are counted (for duplicates), those inside a
+    /// `<template>` are only remembered as valid targets.
+    fn registrar_id(&mut self, fonte: &str, no: Node, atributos: &[Atributo]) {
+        let Some(a) = atributos.iter().find(|a| a.nome == "id") else {
+            return;
+        };
+        let Some(id) = a.valor.as_deref().filter(|v| !v.is_empty()) else {
+            return;
+        };
+        if dentro_de_template(fonte, no) {
+            self.ids_em_template.insert(id.to_string());
+        } else {
+            self.ids.entry(id.to_string()).or_default().push(a.linha);
+        }
+    }
+
+    /// The body of a `<script>` (the `raw_text` right after its start tag, already pushed).
+    fn script(&mut self, fonte: &str, no: Node) {
+        if no.parent().map(|p| p.kind()) != Some("script_element") || self.elementos.is_empty() {
+            return;
+        }
+        self.scripts.push(ScriptInline {
+            elemento: self.elementos.len() - 1,
+            texto: texto(fonte, no).to_string(),
+            linha_inicial: no.start_position().row,
+        });
+    }
+
+    /// Is there any `<script src=…>` (local or remote)? Whatever it runs may create ids.
+    pub fn tem_script_externo(&self) -> bool {
+        self.elementos
+            .iter()
+            .any(|e| e.tag == "script" && e.atributo("src").is_some())
+    }
+}
+
+/// A MISSING node, or an ERROR whose text holds a `<`: tag markup the parser could not place.
+fn erro_que_esconde_marcacao(fonte: &str, no: Node) -> bool {
+    no.is_missing() || (no.is_error() && texto(fonte, no).contains('<'))
+}
+
+/// Is the start tag `no` inside a `<template>` element? (Its own element — the parent of the
+/// start tag — does not count: `<template id="row">` is a live element.)
+fn dentro_de_template(fonte: &str, no: Node) -> bool {
+    let mut atual = no.parent().and_then(|p| p.parent());
+    while let Some(pai) = atual {
+        if pai.kind() == "element" && primeira_tag(fonte, pai) == Some("template") {
+            return true;
+        }
+        atual = pai.parent();
+    }
+    false
+}
+
+/// The (case-preserved) tag name of an `element` node's own start tag.
+fn primeira_tag<'a>(fonte: &'a str, elemento: Node) -> Option<&'a str> {
+    let mut c = elemento.walk();
+    let start = elemento
+        .children(&mut c)
+        .find(|f| f.kind() == "start_tag")?;
+    let mut c2 = start.walk();
+    let nome = start.children(&mut c2).find(|f| f.kind() == "tag_name")?;
+    Some(texto(fonte, nome))
+}
+
+fn texto<'a>(fonte: &'a str, no: Node) -> &'a str {
+    &fonte[no.byte_range()]
+}
+
+/// One `attribute` node; `None` when the parser could not read it whole.
+fn atributo(fonte: &str, no: Node) -> Option<Atributo> {
+    if no.has_error() || no.is_missing() {
+        return None;
+    }
+    let mut nome = None;
+    let mut valor = None;
+    let mut c = no.walk();
+    for filho in no.children(&mut c) {
+        match filho.kind() {
+            "attribute_name" => nome = Some(texto(fonte, filho).to_ascii_lowercase()),
+            "attribute_value" => valor = Some(texto(fonte, filho)),
+            "quoted_attribute_value" => valor = Some(valor_entre_aspas(fonte, filho)),
+            _ => {}
+        }
+    }
+    Some(Atributo {
+        nome: nome?,
+        valor: valor.map(|v| decodificar_entidades(v).into_owned()),
+        linha: no.start_position().row + 1,
+    })
+}
+
+/// The inner `attribute_value` of a quoted value; empty quotes have none.
+fn valor_entre_aspas<'a>(fonte: &'a str, no: Node) -> &'a str {
+    let mut c = no.walk();
+    no.children(&mut c)
+        .find(|f| f.kind() == "attribute_value")
+        .map_or("", |f| texto(fonte, f))
+}
diff --git a/crates/touring-code/src/vgp/lang/html/recurso.rs b/crates/touring-code/src/vgp/lang/html/recurso.rs
new file mode 100644
index 00000000..b212635b
--- /dev/null
+++ b/crates/touring-code/src/vgp/lang/html/recurso.rs
@@ -0,0 +1,554 @@
+//! Class `recurso` (VL0 §4): a LOCAL `src` / `href` that does not exist on disk.
+//!
+//! References are resolved the way a browser opening the file would: relative to the document's
+//! directory (or to a local `<base href>`), with the `?query` and `#fragment` dropped and `%XX`
+//! decoded. A root-relative reference (`/css/a.css`) depends on where the page is served from, which
+//! the file cannot say: it is looked for in every ancestor directory of the document up to the
+//! project root, in the usual web roots (`public/`, `static/`, `dist/`…) and as an absolute path,
+//! and a miss is `Alvo::Incerto`. A relative miss is `Alvo::Projeto`: the disk decides, the file
+//! is the project's and is absent. Whether it may ever `deny` is the POLICY's call, not this
+//! label's: `recurso` is in `CLASSES_CONSULTIVAS` (the next write creates the file — the
+//! `index.html` goes out before the `style.css` it links — and spec §5.1 reserves the "runs now"
+//! deny for symbol classes), so it is a `warn` even in `/tmp/`.
+//!
+//! Out of scope: absolute URLs (`http:`, `data:`, `mailto:`…, protocol-relative `//host`) — a CDN
+//! URL is `cdn`'s, not this class's — and templated values, which are counted as not measured.
+
+use std::collections::HashMap;
+use std::path::{Component, Path, PathBuf};
+
+use super::Saida;
+use super::documento::{Documento, Elemento};
+use super::texto::{decodificar_percentual, mais_proximos, tem_template};
+use crate::vgp::politica::Alvo;
+use crate::vgp::{CheckInput, Finding, is_inline};
+
+/// Web roots a root-relative URL commonly maps onto, tried under each ancestor of the document.
+const RAIZES_WEB: &[&str] = &[
+    "public", "static", "dist", "build", "out", "www", "wwwroot", "htdocs", "site", "_site",
+    "docs", "web",
+];
+
+/// `<a href>` / `<area href>` count only when the target looks like a FILE (a route such as
+/// `/about` or `docs/` is the server's business, not the disk's).
+const EXTENSOES_DE_ARQUIVO: &[&str] = &[
+    "html", "htm", "xhtml", "pdf", "css", "js", "mjs", "json", "xml", "txt", "md", "csv", "png",
+    "jpg", "jpeg", "gif", "svg", "webp", "avif", "ico", "bmp", "mp3", "mp4", "webm", "ogg", "wav",
+    "m4a", "woff", "woff2", "ttf", "otf", "eot", "zip", "gz", "doc", "docx", "xls", "xlsx", "ppt",
+    "pptx", "odt", "epub",
+];
+
+/// `<link rel>` values whose `href` is a file the page loads (not a page address such as
+/// `canonical`, `alternate`, `next`).
+const RELS_DE_ARQUIVO: &[&str] = &[
+    "stylesheet",
+    "icon",
+    "apple-touch-icon",
+    "apple-touch-icon-precomposed",
+    "manifest",
+    "preload",
+    "prefetch",
+    "modulepreload",
+    "mask-icon",
+];
+
+/// A local reference found in the document.
+struct Referencia {
+    /// As written, without `?query` / `#fragment`.
+    escrito: String,
+    /// 1-based line of the attribute.
+    linha: usize,
+    /// `img src`, `link href`…
+    origem: String,
+}
+
+/// What one attribute value is.
+enum Valor {
+    Local(String),
+    /// Templated or computed: cannot be resolved from the file.
+    Dinamico,
+    /// Absolute URL, fragment, empty: not this class's business.
+    Ignorado,
+}
+
+/// Report every local reference of `doc` that resolves to nothing.
+pub(super) fn verificar(input: &CheckInput, doc: &Documento, saida: &mut Saida) {
+    let (referencias, dinamicas) = colher(doc);
+    if dinamicas > 0 {
+        saida.nao_medido(format!(
+            "{dinamicas} referência(s) com valor dinâmico ou de template não resolvida(s)"
+        ));
+    }
+    if referencias.is_empty() {
+        return;
+    }
+    let Some(mut disco) = Disco::de(input, doc) else {
+        saida.nao_medido(format!(
+            "caminho `{}` sem diretório: {} referência(s) local(is) não resolvida(s)",
+            input.path,
+            referencias.len()
+        ));
+        return;
+    };
+    if let Some(motivo) = disco.motivo_de_nao_medir.take() {
+        saida.nao_medido(motivo);
+        return;
+    }
+    for (escrito, grupo) in agrupar(&referencias) {
+        if let Resolucao::Ausente { alvo, resolvido } = disco.resolver(escrito) {
+            let vizinhos = disco.vizinhos(&resolvido);
+            saida.achado(achado(escrito, &grupo, alvo, &resolvido, vizinhos));
+        }
+    }
+}
+
+/// Every local reference of the document, plus how many dynamic ones were skipped.
+fn colher(doc: &Documento) -> (Vec<Referencia>, usize) {
+    let mut referencias = Vec::new();
+    let mut dinamicas = 0;
+    for el in &doc.elementos {
+        for (atributo, valor) in valores_de_recurso(el) {
+            let linha = el.atributo(atributo).map_or(el.linha, |a| a.linha);
+            match classificar(&valor, el) {
+                Valor::Local(escrito) => referencias.push(Referencia {
+                    escrito,
+                    linha,
+                    origem: format!("{} {atributo}", el.tag),
+                }),
+                Valor::Dinamico => dinamicas += 1,
+                Valor::Ignorado => {}
+            }
+        }
+    }
+    (referencias, dinamicas)
+}
+
+/// The attributes of `el` that name a file the page loads.
+fn atributos_de_recurso(el: &Elemento) -> &'static [&'static str] {
+    match el.tag.as_str() {
+        "script" | "iframe" | "embed" | "audio" | "track" | "frame" => &["src"],
+        "img" | "source" => &["src", "srcset"],
+        "video" => &["src", "poster"],
+        "object" => &["data"],
+        "input"
+            if el
+                .valor("type")
+                .is_some_and(|t| t.eq_ignore_ascii_case("image")) =>
+        {
+            &["src"]
+        }
+        "link" if link_de_arquivo(el) => &["href"],
+        "a" | "area" => &["href"],
+        _ => &[],
+    }
+}
+
+/// The (attribute, value) pairs of `el` that name a file the page loads — one pair per URL of a
+/// `srcset`.
+fn valores_de_recurso(el: &Elemento) -> Vec<(&'static str, String)> {
+    let mut out = Vec::new();
+    for &nome in atributos_de_recurso(el) {
+        let Some(v) = el.valor(nome) else { continue };
+        if nome == "srcset" {
+            out.extend(candidatos_de_srcset(v).into_iter().map(|c| (nome, c)));
+        } else {
+            out.push((nome, v.to_string()));
+        }
+    }
+    out
+}
+
+fn link_de_arquivo(el: &Elemento) -> bool {
+    el.valor("rel").is_some_and(|rel| {
+        rel.split_ascii_whitespace()
+            .any(|t| RELS_DE_ARQUIVO.contains(&t.to_ascii_lowercase().as_str()))
+    })
+}
+
+/// The URLs of a `srcset` (`a.png 1x, b.png 2x`): each candidate's URL ends at the first blank,
+/// so a `data:` URL with a comma stays whole.
+fn candidatos_de_srcset(valor: &str) -> Vec<String> {
+    let mut out = Vec::new();
+    let mut resto = valor;
+    loop {
+        resto = resto.trim_start_matches(|c: char| c.is_ascii_whitespace() || c == ',');
+        if resto.is_empty() {
+            return out;
+        }
+        let fim = resto.find(char::is_whitespace).unwrap_or(resto.len());
+        let token = &resto[..fim];
+        out.push(token.trim_end_matches(',').to_string());
+        let depois = &resto[fim..];
+        // a URL that ends with a comma has no descriptor; otherwise the descriptor runs to the next comma
+        resto = if token.ends_with(',') {
+            depois
+        } else {
+            &depois[depois.find(',').unwrap_or(depois.len())..]
+        };
+    }
+}
+
+fn classificar(valor: &str, el: &Elemento) -> Valor {
+    let escrito: String = valor
+        .chars()
+        .filter(|c| !matches!(c, '\t' | '\n' | '\r'))
+        .collect::<String>()
+        .trim()
+        .to_string();
+    // a browser reads `\` as `/` in a URL; the name keeps what was written
+    let v = escrito.replace('\\', "/");
+    if v.is_empty() {
+        return Valor::Ignorado;
+    }
+    // `#frag` points INSIDE the document (class `ancora`, which counts its own templated ones);
+    // `#{x}` is Pug/Ruby interpolation, not a fragment
+    if v.starts_with('#') && !v.starts_with("#{") {
+        return Valor::Ignorado;
+    }
+    if tem_template(&v) {
+        return Valor::Dinamico;
+    }
+    if v.starts_with("//") || tem_esquema(&v) {
+        return Valor::Ignorado;
+    }
+    let caminho = v.split(['?', '#']).next().unwrap_or("");
+    if caminho.is_empty() {
+        return Valor::Ignorado;
+    }
+    if matches!(el.tag.as_str(), "a" | "area") && !parece_arquivo(caminho) {
+        return Valor::Ignorado;
+    }
+    let nome = escrito.split(['?', '#']).next().unwrap_or("");
+    Valor::Local(nome.to_string())
+}
+
+/// `http:`, `data:`, `mailto:`, `javascript:`, `C:`… — a scheme is a letter followed by letters,
+/// digits, `+`, `-`, `.` and a colon.
+fn tem_esquema(v: &str) -> bool {
+    let mut cs = v.chars();
+    cs.next().is_some_and(|c| c.is_ascii_alphabetic())
+        && v.split_once(':').is_some_and(|(esq, _)| {
+            esq.chars()
+                .all(|c| c.is_ascii_alphanumeric() || matches!(c, '+' | '-' | '.'))
+        })
+}
+
+fn parece_arquivo(caminho: &str) -> bool {
+    Path::new(caminho)
+        .extension()
+        .and_then(|e| e.to_str())
+        .is_some_and(|e| EXTENSOES_DE_ARQUIVO.contains(&e.to_ascii_lowercase().as_str()))
+}
+
+/// References grouped by what is written, in order of first appearance.
+fn agrupar(referencias: &[Referencia]) -> Vec<(&str, Vec<&Referencia>)> {
+    let mut indice: HashMap<&str, usize> = HashMap::new();
+    let mut grupos: Vec<(&str, Vec<&Referencia>)> = Vec::new();
+    for r in referencias {
+        let i = *indice.entry(r.escrito.as_str()).or_insert_with(|| {
+            grupos.push((r.escrito.as_str(), Vec::new()));
+            grupos.len() - 1
+        });
+        grupos[i].1.push(r);
+    }
+    grupos
+}
+
+/// How a reference resolves.
+enum Resolucao {
+    Existe,
+    Ausente { alvo: Alvo, resolvido: PathBuf },
+}
+
+/// The file system as the document sees it.
+struct Disco<'a> {
+    /// Directory references resolve against (the document's, or a local `<base href>`'s).
+    base: PathBuf,
+    /// Directory of the document itself — where ancestors are counted from.
+    dir_doc: PathBuf,
+    raiz: &'a Path,
+    overlays: &'a HashMap<String, String>,
+    cache: HashMap<PathBuf, bool>,
+    /// Sorted names inside each directory listed for "você quis dizer" (`None`: no such directory).
+    listagens: HashMap<PathBuf, Option<Vec<String>>>,
+    /// Set when the whole class is unmeasurable for this document (remote `<base href>`).
+    motivo_de_nao_medir: Option<String>,
+}
+
+impl<'a> Disco<'a> {
+    /// `None` for a virtual path (`<string>`, `<stdin>`) or one with no parent directory.
+    fn de(input: &'a CheckInput, doc: &Documento) -> Option<Self> {
+        if is_inline(&input.path) {
+            return None;
+        }
+        let caminho = Path::new(&input.path);
+        let absoluto = if caminho.is_absolute() {
+            caminho.to_path_buf()
+        } else {
+            input.project_root.join(caminho)
+        };
+        let dir_doc = absoluto.parent()?.to_path_buf();
+        let (base, motivo) = base_do_documento(doc, &dir_doc);
+        Some(Self {
+            base,
+            dir_doc,
+            raiz: &input.project_root,
+            overlays: &input.overlays,
+            cache: HashMap::new(),
+            listagens: HashMap::new(),
+            motivo_de_nao_medir: motivo,
+        })
+    }
+
+    fn existe(&mut self, p: &Path) -> bool {
+        let p = normalizar(p);
+        if let Some(&b) = self.cache.get(&p) {
+            return b;
+        }
+        let b = p.exists() || self.overlays.contains_key(p.to_string_lossy().as_ref());
+        self.cache.insert(p, b);
+        b
+    }
+
+    fn resolver(&mut self, escrito: &str) -> Resolucao {
+        let escrito = escrito.replace('\\', "/");
+        let escrito = escrito.as_str();
+        let variantes: Vec<String> = std::iter::once(escrito.to_string())
+            .chain(decodificar_percentual(escrito))
+            .collect();
+        if let Some(rel) = escrito.strip_prefix('/') {
+            return self.resolver_da_raiz(rel, &variantes);
+        }
+        for v in &variantes {
+            if self.existe(&self.base.join(v)) {
+                return Resolucao::Existe;
+            }
+        }
+        Resolucao::Ausente {
+            alvo: Alvo::Projeto,
+            resolvido: self.base.join(escrito),
+        }
+    }
+
+    /// The names in the missing file's directory closest to it and — when that directory itself
+    /// does not exist — the directory. Each directory is listed once per document.
+    fn vizinhos(&mut self, resolvido: &Path) -> Vizinhos {
+        let (Some(dir), Some(nome)) = (
+            resolvido.parent(),
+            resolvido.file_name().and_then(|n| n.to_str()),
+        ) else {
+            return Vizinhos::default();
+        };
+        let lista = self
+            .listagens
+            .entry(dir.to_path_buf())
+            .or_insert_with(|| listar(dir));
+        match lista {
+            Some(nomes) => Vizinhos {
+                parecidos: mais_proximos(nome, nomes.iter().map(String::as_str), 5),
+                dir_inexistente: None,
+            },
+            None => Vizinhos {
+                parecidos: Vec::new(),
+                dir_inexistente: Some(dir.to_path_buf()),
+            },
+        }
+    }
+
+    /// `/x/y`: where the page is served from is unknown, so try every plausible root — the
+    /// ancestors of the document (and the usual web roots under each), then the absolute path.
+    /// A candidate root whose first segment (`/_next` of `/_next/static/a.js`) does not exist is
+    /// dropped after ONE check, shared by every reference that starts with it.
+    fn resolver_da_raiz(&mut self, rel: &str, variantes: &[String]) -> Resolucao {
+        let raizes = self.raizes_candidatas();
+        for v in variantes {
+            let v = v.trim_start_matches('/');
+            let (primeiro, resto) = v.split_once('/').unwrap_or((v, ""));
+            for raiz in &raizes {
+                if !resto.is_empty() && !self.existe(&raiz.join(primeiro)) {
+                    continue;
+                }
+                if self.existe(&raiz.join(v)) {
+                    return Resolucao::Existe;
+                }
+            }
+        }
+        Resolucao::Ausente {
+            alvo: Alvo::Incerto,
+            resolvido: self.raiz.join(rel),
+        }
+    }
+
+    /// Every directory a root-relative URL may be served from.
+    fn raizes_candidatas(&self) -> Vec<PathBuf> {
+        let mut raizes = Vec::new();
+        for a in self.ancestrais() {
+            raizes.extend(RAIZES_WEB.iter().map(|w| a.join(w)));
+            raizes.push(a);
+        }
+        raizes.push(PathBuf::from("/"));
+        raizes
+    }
+
+    /// The document's directory and each parent up to the project root (only the project root
+    /// besides, when the document lives outside it).
+    fn ancestrais(&self) -> Vec<PathBuf> {
+        if !self.dir_doc.starts_with(self.raiz) {
+            return vec![self.dir_doc.clone(), self.raiz.to_path_buf()];
+        }
+        self.dir_doc
+            .ancestors()
+            .take_while(|a| a.starts_with(self.raiz))
+            .map(Path::to_path_buf)
+            .collect()
+    }
+}
+
+/// The directory relative references resolve against: the document's, or the one a local
+/// `<base href>` names; a remote base makes the class unmeasurable.
+fn base_do_documento(doc: &Documento, dir_doc: &Path) -> (PathBuf, Option<String>) {
+    let Some(href) = doc
+        .elementos
+        .iter()
+        .filter(|e| e.tag == "base")
+        .find_map(|e| e.valor("href").map(str::trim).filter(|v| !v.is_empty()))
+    else {
+        return (dir_doc.to_path_buf(), None);
+    };
+    if href.starts_with("//") || tem_esquema(href) {
+        return (
+            dir_doc.to_path_buf(),
+            Some(format!(
+                "documento com `<base href=\"{href}\">` externo: referências relativas não resolvidas"
+            )),
+        );
+    }
+    let caminho = href.split(['?', '#']).next().unwrap_or("");
+    let diretorio = if caminho.ends_with('/') || caminho.is_empty() {
+        caminho
+    } else {
+        caminho.rsplit_once('/').map_or("", |(d, _)| d)
+    };
+    (dir_doc.join(diretorio), None)
+}
+
+/// Lexical normalization (`a/../b` → `b`), so overlay keys compare as written by the hook.
+fn normalizar(p: &Path) -> PathBuf {
+    let mut out = PathBuf::new();
+    for c in p.components() {
+        match c {
+            Component::ParentDir => {
+                if !out.pop() {
+                    out.push("..");
+                }
+            }
+            Component::CurDir => {}
+            outro => out.push(outro.as_os_str()),
+        }
+    }
+    out
+}
+
+fn achado(
+    escrito: &str,
+    grupo: &[&Referencia],
+    alvo: Alvo,
+    resolvido: &Path,
+    vizinhos: Vizinhos,
+) -> Finding {
+    let primeira = grupo[0];
+    let Vizinhos {
+        parecidos: reais,
+        dir_inexistente,
+    } = vizinhos;
+    let mut sugestao = format!(
+        "recurso local inexistente: `{escrito}` ({}) — resolvido como `{}`",
+        primeira.origem,
+        resolvido.display()
+    );
+    if grupo.len() > 1 {
+        sugestao.push_str(&format!(" (+{} outra(s) referência(s))", grupo.len() - 1));
+    }
+    match (reais.first(), dir_inexistente) {
+        (Some(proximo), _) => {
+            let prefixo = escrito.rsplit_once('/').map_or("", |(d, _)| d);
+            let sugerido = if prefixo.is_empty() {
+                proximo.clone()
+            } else {
+                format!("{prefixo}/{proximo}")
+            };
+            sugestao.push_str(&format!(". Você quis dizer `{sugerido}`?"));
+        }
+        (None, Some(dir)) => {
+            sugestao.push_str(&format!(". O diretório `{}` não existe", dir.display()))
+        }
+        (None, None) => {}
+    }
+    Finding::candidato("recurso", escrito, primeira.linha, alvo, sugestao, reais)
+}
+
+/// What the directory of a missing file offers.
+#[derive(Default)]
+struct Vizinhos {
+    /// Names in the directory closest to the missing one.
+    parecidos: Vec<String>,
+    /// Set when the directory itself does not exist.
+    dir_inexistente: Option<PathBuf>,
+}
+
+/// The sorted names inside `dir`, or `None` when it cannot be listed.
+fn listar(dir: &Path) -> Option<Vec<String>> {
+    let mut nomes: Vec<String> = std::fs::read_dir(dir)
+        .ok()?
+        .flatten()
+        .filter_map(|e| e.file_name().into_string().ok())
+        .collect();
+    nomes.sort_unstable();
+    Some(nomes)
+}
+
+#[cfg(test)]
+mod unit {
+    use super::*;
+
+    #[test]
+    fn srcset_separa_candidatos_sem_quebrar_data_url() {
+        assert_eq!(
+            candidatos_de_srcset("a.png 1x, b.png 2x"),
+            vec!["a.png", "b.png"]
+        );
+        assert_eq!(
+            candidatos_de_srcset("data:image/png;base64,AAAA 1x, c.png"),
+            vec!["data:image/png;base64,AAAA", "c.png"]
+        );
+        // a vírgula separa candidatos só depois de espaço ou no fim da URL (WHATWG, "srcset
+        // attribute"): `a.png,b.png` é UMA URL, `a.png, b.png` e `a.png,` não
+        assert_eq!(candidatos_de_srcset("a.png,b.png"), vec!["a.png,b.png"]);
+        assert_eq!(candidatos_de_srcset("a.png, b.png"), vec!["a.png", "b.png"]);
+        assert_eq!(candidatos_de_srcset("a.png,"), vec!["a.png"]);
+        assert!(candidatos_de_srcset("  ").is_empty());
+    }
+
+    #[test]
+    fn normalizar_resolve_pontos_lexicamente() {
+        assert_eq!(
+            normalizar(Path::new("/p/site/pages/../css/a.css")),
+            PathBuf::from("/p/site/css/a.css")
+        );
+        assert_eq!(normalizar(Path::new("/p/./a")), PathBuf::from("/p/a"));
+    }
+
+    #[test]
+    fn esquema_so_com_letra_inicial_e_dois_pontos() {
+        assert!(tem_esquema("https://x"));
+        assert!(tem_esquema("mailto:a@b"));
+        assert!(tem_esquema("data:image/png;base64,AA"));
+        assert!(tem_esquema("javascript:void(0)"));
+        assert!(
+            !tem_esquema("img/a:b.png"),
+            "dois-pontos depois de barra não é esquema"
+        );
+        assert!(!tem_esquema("./a.png"));
+        assert!(!tem_esquema("1http:x"));
+    }
+}
diff --git a/crates/touring-code/src/vgp/lang/html/script.rs b/crates/touring-code/src/vgp/lang/html/script.rs
new file mode 100644
index 00000000..0740d677
--- /dev/null
+++ b/crates/touring-code/src/vgp/lang/html/script.rs
@@ -0,0 +1,411 @@
+//! The inline `<script>` bodies of an html document, re-parsed with the `javascript` grammar
+//! (`<script>` text is a `raw_text` node in `tree-sitter-html`; the injection query names
+//! `javascript` as its language).
+//!
+//! Two products, from one walk of each script:
+//! - the DOM lookups with a literal argument (`document.getElementById('x')`,
+//!   `document.querySelector('#x .y')`) — checked against the document's ids by
+//!   [`verificar_lookups`];
+//! - the ids a script may CREATE (a string equal to the id, an `id="x"` inside a template string,
+//!   a template `<script type="text/template">`), so that neither a lookup nor an `href="#x"` is
+//!   reported against an id the page builds at run time. Anything the walk cannot follow
+//!   (`el.id = name`, `innerHTML = html`, a script with a syntax error, an unknown `type`) sets
+//!   `dinamico`: the lookups stand down and the anchors lose their right to a `deny`.
+//!
+//! Grammar (`tree-sitter-javascript` 0.25.0, `src/node-types.json`): `call_expression` has the
+//! fields `function` and `arguments`; `member_expression` has `object` and `property`;
+//! `assignment_expression` has `left` and `right`; a `string` holds `string_fragment`s,
+//! `escape_sequence`s and `html_character_reference`s; a `template_string` also holds
+//! `template_substitution`s.
+
+use std::collections::HashSet;
+
+use tree_sitter::Node;
+
+use super::Saida;
+use super::documento::{Documento, Elemento, ScriptInline};
+use super::texto::{ids_no_texto, tem_template};
+use crate::vgp::Finding;
+use crate::vgp::lang::parse;
+use crate::vgp::politica::Alvo;
+
+/// An inline script above this size is not re-parsed (the cost of the `javascript` parse would
+/// dominate the hook): inlined data blobs and bundles are not what an edit writes by hand.
+pub(super) const TETO_DO_SCRIPT: usize = 512 << 10;
+
+/// The budget of ALL inline scripts of one document.
+const TETO_TOTAL_DE_SCRIPTS: usize = 2 << 20;
+
+/// What kind of text a `<script type=…>` holds.
+enum Tipo {
+    /// Classic or module JavaScript.
+    Js,
+    /// Data blocks (`application/json`, `importmap`…): not DOM code.
+    Dados,
+    /// Markup the page instantiates later (`text/template`, `text/html`…).
+    Template,
+    /// A type the adapter does not know: it may build anything.
+    Desconhecido,
+}
+
+fn tipo(el: &Elemento) -> Tipo {
+    let t = el.valor("type").unwrap_or("").trim().to_ascii_lowercase();
+    match t.as_str() {
+        ""
+        | "module"
+        | "text/javascript"
+        | "application/javascript"
+        | "text/ecmascript"
+        | "application/ecmascript"
+        | "application/x-javascript"
+        | "text/x-javascript"
+        | "text/jsx"
+        | "text/babel" => Tipo::Js,
+        "application/json"
+        | "application/ld+json"
+        | "importmap"
+        | "speculationrules"
+        | "text/json" => Tipo::Dados,
+        _ if t.contains("template") || t == "text/html" || t.starts_with("text/x-handlebars") => {
+            Tipo::Template
+        }
+        _ => Tipo::Desconhecido,
+    }
+}
+
+/// One `getElementById` / `querySelector*` call with a literal argument.
+pub(super) struct Lookup {
+    pub id: String,
+    /// 1-based line in the html document.
+    pub linha: usize,
+    /// Source of the call, for the teaching message (`document.getElementById('x')`).
+    pub chamada: String,
+}
+
+/// The product of walking every inline script of a document.
+#[derive(Default)]
+pub(super) struct AnaliseScripts {
+    pub lookups: Vec<Lookup>,
+    /// Ids a script may create at run time.
+    pub criados: HashSet<String>,
+    /// Some script builds ids or markup the walk cannot follow.
+    pub dinamico: bool,
+    /// Why part of the scripts was not measured.
+    pub motivos: Vec<String>,
+    /// Bytes of script already parsed (against [`TETO_TOTAL_DE_SCRIPTS`]).
+    bytes_lidos: usize,
+}
+
+/// Walk every inline script of `doc`.
+pub(super) fn analisar(doc: &Documento) -> AnaliseScripts {
+    let mut out = AnaliseScripts::default();
+    for s in &doc.scripts {
+        let el = &doc.elementos[s.elemento];
+        if el.atributo("src").is_some() {
+            continue; // a body next to a `src` is never executed
+        }
+        match tipo(el) {
+            Tipo::Js => analisar_js(s, &mut out),
+            Tipo::Dados => {}
+            Tipo::Template => registrar_ids_do_texto(&s.texto, &mut out),
+            Tipo::Desconhecido => out.dinamico = true,
+        }
+    }
+    out
+}
+
+fn registrar_ids_do_texto(texto: &str, out: &mut AnaliseScripts) {
+    for id in ids_no_texto(texto) {
+        if tem_template(id) {
+            out.dinamico = true;
+        }
+        out.criados.insert(id.to_string());
+    }
+}
+
+fn analisar_js(s: &ScriptInline, out: &mut AnaliseScripts) {
+    if s.texto.len() > TETO_DO_SCRIPT || out.bytes_lidos + s.texto.len() > TETO_TOTAL_DE_SCRIPTS {
+        out.dinamico = true;
+        out.motivos.push(format!(
+            "script inline de {} KiB acima do limite de leitura: chamadas de DOM não medidas",
+            s.texto.len() >> 10
+        ));
+        return;
+    }
+    out.bytes_lidos += s.texto.len();
+    let tree = match parse("javascript", &s.texto) {
+        Ok(t) if !t.root_node().has_error() => t,
+        Ok(_) => {
+            out.dinamico = true;
+            out.motivos.push(format!(
+                "script inline na linha {} com erro de sintaxe: chamadas de DOM não medidas",
+                s.linha_inicial + 1
+            ));
+            return;
+        }
+        Err(e) => {
+            out.dinamico = true;
+            out.motivos.push(format!("script inline não lido: {e}"));
+            return;
+        }
+    };
+    let mut ignorados: HashSet<usize> = HashSet::new();
+    let mut cur = tree.walk();
+    loop {
+        let no = cur.node();
+        match no.kind() {
+            "call_expression" => chamada(&s.texto, no, s.linha_inicial, &mut ignorados, out),
+            "assignment_expression" | "augmented_assignment_expression" => {
+                atribuicao(&s.texto, no, out)
+            }
+            "string" | "template_string" if !ignorados.contains(&no.id()) => {
+                literal_solto(&s.texto, no, out)
+            }
+            _ => {}
+        }
+        if cur.goto_first_child() {
+            continue;
+        }
+        while !cur.goto_next_sibling() {
+            if !cur.goto_parent() {
+                return;
+            }
+        }
+    }
+}
+
+fn texto<'a>(fonte: &'a str, no: Node) -> &'a str {
+    &fonte[no.byte_range()]
+}
+
+/// `document`, `window.document`, `globalThis.document`, `self.document`.
+fn eh_document(fonte: &str, obj: Node) -> bool {
+    match obj.kind() {
+        "identifier" => texto(fonte, obj) == "document",
+        "member_expression" => {
+            let prop = obj.child_by_field_name("property");
+            let base = obj.child_by_field_name("object");
+            matches!((base, prop), (Some(b), Some(p))
+                if texto(fonte, p) == "document"
+                    && matches!(texto(fonte, b), "window" | "globalThis" | "self"))
+        }
+        _ => false,
+    }
+}
+
+/// The text of a string literal with no escape and no interpolation; `None` otherwise (the
+/// adapter never guesses what an escaped or interpolated string evaluates to).
+fn literal(fonte: &str, no: Node) -> Option<String> {
+    let bruto = texto(fonte, no);
+    let miolo = match no.kind() {
+        "string" => bruto.get(1..bruto.len().checked_sub(1)?)?,
+        "template_string" => bruto.get(1..bruto.len().checked_sub(1)?)?,
+        _ => return None,
+    };
+    let com_escape_ou_interpolacao = miolo.contains('\\') || miolo.contains("${");
+    (!com_escape_ou_interpolacao).then(|| miolo.to_string())
+}
+
+fn argumentos(chamada: Node) -> Vec<Node> {
+    let Some(args) = chamada.child_by_field_name("arguments") else {
+        return Vec::new();
+    };
+    let mut c = args.walk();
+    args.named_children(&mut c).collect()
+}
+
+fn chamada(
+    fonte: &str,
+    no: Node,
+    linha_inicial: usize,
+    ignorados: &mut HashSet<usize>,
+    out: &mut AnaliseScripts,
+) {
+    let Some((obj, nome)) = receptor_e_metodo(fonte, no) else {
+        return;
+    };
+    let args = argumentos(no);
+    if matches!(
+        nome,
+        "getElementById" | "querySelector" | "querySelectorAll"
+    ) && eh_document(fonte, obj)
+    {
+        let linha = linha_inicial + no.start_position().row + 1;
+        registrar_lookup(fonte, nome, &args, linha, ignorados, out);
+    } else if cria_marcacao_dinamica(fonte, nome, obj, &args) {
+        out.dinamico = true;
+    }
+}
+
+/// `obj.nome(…)`: the receiver and the method name of a call.
+fn receptor_e_metodo<'a>(fonte: &'a str, no: Node<'a>) -> Option<(Node<'a>, &'a str)> {
+    let f = no.child_by_field_name("function")?;
+    if f.kind() != "member_expression" {
+        return None;
+    }
+    let obj = f.child_by_field_name("object")?;
+    let prop = f.child_by_field_name("property")?;
+    Some((obj, texto(fonte, prop)))
+}
+
+/// A lookup with a literal argument: remember each id it requires, and keep its string out of
+/// the "created ids" set (it names an id, it does not build one).
+fn registrar_lookup(
+    fonte: &str,
+    nome: &str,
+    args: &[Node],
+    linha: usize,
+    ignorados: &mut HashSet<usize>,
+    out: &mut AnaliseScripts,
+) {
+    let Some(arg) = args.first() else { return };
+    let Some(lit) = literal(fonte, *arg) else {
+        return;
+    };
+    ignorados.insert(arg.id());
+    let ids = if nome == "getElementById" {
+        vec![lit]
+    } else {
+        ids_do_seletor(&lit)
+    };
+    let chamada = format!("document.{nome}({})", texto(fonte, *arg));
+    out.lookups.extend(ids.into_iter().map(|id| Lookup {
+        id,
+        linha,
+        chamada: chamada.clone(),
+    }));
+}
+
+/// `setAttribute('id', x)`, `insertAdjacentHTML(pos, x)`, `document.write(x)` with a non-literal
+/// `x`: the script builds ids the walk cannot follow.
+fn cria_marcacao_dinamica(fonte: &str, nome: &str, obj: Node, args: &[Node]) -> bool {
+    let nao_literal = |i: usize| args.get(i).is_some_and(|a| literal(fonte, *a).is_none());
+    match nome {
+        "setAttribute" => {
+            args.first().and_then(|a| literal(fonte, *a)).as_deref() == Some("id") && nao_literal(1)
+        }
+        "insertAdjacentHTML" => nao_literal(1),
+        "write" | "writeln" => eh_document(fonte, obj) && (0..args.len()).any(nao_literal),
+        _ => false,
+    }
+}
+
+/// `el.id = x`, `el.innerHTML = x` (and `+=`): fine with a literal on the right, dynamic otherwise.
+fn atribuicao(fonte: &str, no: Node, out: &mut AnaliseScripts) {
+    let (Some(esq), Some(dir)) = (
+        no.child_by_field_name("left"),
+        no.child_by_field_name("right"),
+    ) else {
+        return;
+    };
+    if esq.kind() != "member_expression" {
+        return;
+    }
+    let Some(prop) = esq.child_by_field_name("property") else {
+        return;
+    };
+    let cria = matches!(texto(fonte, prop), "id" | "innerHTML" | "outerHTML");
+    if cria && literal(fonte, dir).is_none() {
+        out.dinamico = true;
+    }
+}
+
+/// A string that is not a lookup argument: it may BE an id (`el.id = 'x'`, `{ id: 'x' }`) or hold
+/// markup with ids (`'<div id="x">'`). Over-approximating what a script can create is the safe side.
+fn literal_solto(fonte: &str, no: Node, out: &mut AnaliseScripts) {
+    let bruto = texto(fonte, no);
+    let Some(miolo) = bruto.get(1..bruto.len().saturating_sub(1)) else {
+        return;
+    };
+    if !miolo.is_empty() && miolo.len() <= 200 && !miolo.contains(char::is_whitespace) {
+        out.criados.insert(miolo.to_string());
+    }
+    registrar_ids_do_texto(miolo, out);
+}
+
+/// The ids a CSS selector REQUIRES in the document: `#a` of `#a .b > c`, never those inside
+/// `:not(…)`/`:is(…)`/`[…]`, and none for a selector list (`#a, #b` matches with either) or one
+/// with escapes.
+fn ids_do_seletor(sel: &str) -> Vec<String> {
+    let cs: Vec<char> = sel.chars().collect();
+    let Some(topo) = posicoes_de_topo(&cs) else {
+        return Vec::new();
+    };
+    let mut ids = Vec::new();
+    for (i, _) in cs
+        .iter()
+        .enumerate()
+        .filter(|(i, c)| **c == '#' && topo[*i])
+    {
+        let id: String = cs[i + 1..]
+            .iter()
+            .take_while(|c| c.is_alphanumeric() || matches!(c, '-' | '_'))
+            .collect();
+        if id.chars().next().is_some_and(|c| !c.is_ascii_digit()) {
+            ids.push(id);
+        }
+    }
+    ids
+}
+
+/// For each character of a selector: is it at the top level (outside parentheses, brackets and
+/// quotes)? `None` when the selector is a list (`,` at the top level) or has escapes.
+fn posicoes_de_topo(cs: &[char]) -> Option<Vec<bool>> {
+    let (mut paren, mut colchete) = (0usize, 0usize);
+    let mut aspa: Option<char> = None;
+    let mut topo = Vec::with_capacity(cs.len());
+    for &c in cs {
+        let no_topo = paren == 0 && colchete == 0 && aspa.is_none();
+        topo.push(no_topo);
+        if let Some(q) = aspa {
+            if c == q {
+                aspa = None;
+            }
+            continue;
+        }
+        match c {
+            '"' | '\'' => aspa = Some(c),
+            '(' => paren += 1,
+            ')' => paren = paren.saturating_sub(1),
+            '[' => colchete += 1,
+            ']' => colchete = colchete.saturating_sub(1),
+            ',' if no_topo => return None,
+            '\\' => return None,
+            _ => {}
+        }
+    }
+    Some(topo)
+}
+
+/// Report every lookup whose id no element of the document carries and no script creates.
+/// A script that builds ids dynamically makes the whole class unmeasurable.
+pub(super) fn verificar_lookups(
+    scripts: &AnaliseScripts,
+    presentes: &HashSet<&str>,
+    saida: &mut Saida,
+) {
+    if scripts.dinamico {
+        if !scripts.lookups.is_empty() {
+            saida.nao_medido(
+                "script cria ids ou marcação por dados dinâmicos: chamadas de DOM não medidas",
+            );
+        }
+        return;
+    }
+    for l in &scripts.lookups {
+        if presentes.contains(l.id.as_str()) {
+            continue;
+        }
+        saida.achado(Finding::candidato(
+            "ancora",
+            &l.id,
+            l.linha,
+            Alvo::Incerto,
+            format!(
+                "`{}` procura o id `{}`, que nenhum elemento do documento tem",
+                l.chamada, l.id
+            ),
+            Vec::new(),
+        ));
+    }
+}
diff --git a/crates/touring-code/src/vgp/lang/html/tests/ancora.rs b/crates/touring-code/src/vgp/lang/html/tests/ancora.rs
