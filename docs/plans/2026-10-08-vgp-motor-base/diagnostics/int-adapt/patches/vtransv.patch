+                .iter()
+                .map(|c| format!("`{c}`"))
+                .collect::<Vec<_>>()
+                .join(", ")
+        ),
+    };
+    Finding::candidato(
+        "classe_css",
+        &uso.classe,
+        uso.linha,
+        Alvo::Projeto,
+        format!(
+            "a classe `{}` não é definida por nenhuma folha carregada ({} lida(s)){dica}",
+            uso.classe, folhas.lidas
+        ),
+        proximas,
+    )
