+    assert!(v.nao_medido.is_none(), "{:?}", v.nao_medido);
+    let f = &v.achados[0];
+    assert_eq!(f.classe, "classe_css");
+    assert_eq!(f.alvo, Alvo::Projeto);
+    assert!(f.sugestao.contains("você quis dizer"), "{}", f.sugestao);
