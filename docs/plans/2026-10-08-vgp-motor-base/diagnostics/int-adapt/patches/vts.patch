+#[test]
+fn export_star_nao_resolvido_vira_nao_medido_e_nao_achado() {
+    let p = projeto(&[(
+        "m.ts",
+        "export * from 'pacote-externo'; export const a = 1;",
+    )]);
+    let out = rodar(
+        p.path(),
+        "a.ts",
+        "typescript",
