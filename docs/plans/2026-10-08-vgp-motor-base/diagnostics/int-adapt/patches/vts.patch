+        };
+        let mut ultimo = None;
+        let mut pilha = vec![arvore.root_node()];
+        while let Some(n) = pilha.pop() {
+            if n.kind() == "member_expression"
+                && ultimo.is_none_or(|u: Node| n.start_byte() > u.start_byte())
+            {
+                ultimo = Some(n);
+            }
+            let mut c = n.walk();
+            pilha.extend(n.named_children(&mut c));
+        }
+        let m = ultimo.expect("member_expression");
+        inf.inferir(m.child_by_field_name("object").expect("object"), 0)
+    }
+
+    fn nome_da_forma(r: &Resultado) -> Option<String> {
+        match r {
+            Resultado::Forma(f) => Some(f.nome.clone()),
+            _ => None,
+        }
+    }
+
+    #[test]
+    fn new_de_builtin_e_literais() {
+        assert_eq!(
+            nome_da_forma(&receptor("typescript", "new Date().foo;")).as_deref(),
+            Some("Date")
+        );
+        assert_eq!(
+            nome_da_forma(&receptor("typescript", "'abc'.foo;")).as_deref(),
+            Some("String")
+        );
+        assert_eq!(
+            nome_da_forma(&receptor("typescript", "[1, 2].foo;")).as_deref(),
+            Some("Array")
+        );
+        assert_eq!(
+            nome_da_forma(&receptor("typescript", "(1).foo;")).as_deref(),
+            Some("Number")
+        );
+        assert_eq!(
+            nome_da_forma(&receptor("typescript", "(new Date()).foo;")).as_deref(),
+            Some("Date")
+        );
+    }
+
+    #[test]
+    fn new_de_nome_ligado_localmente_nao_e_o_builtin() {
+        assert!(
+            nome_da_forma(&receptor(
+                "typescript",
+                "import { Date } from 'luxon'; new Date().foo;"
+            ))
+            .is_none()
+        );
+        assert!(
+            nome_da_forma(&receptor(
+                "typescript",
+                "function f(Date: any) { new Date().foo; }"
+            ))
+            .is_none()
+        );
+    }
+
+    #[test]
+    fn identificador_const_anotado_e_inferido() {
+        assert_eq!(
+            nome_da_forma(&receptor("typescript", "const d = new Date(); d.foo;")).as_deref(),
+            Some("Date")
+        );
+        assert_eq!(
+            nome_da_forma(&receptor(
+                "typescript",
+                "interface P { a: 1 } function f(p: P) { p.foo; }"
+            ))
+            .as_deref(),
+            Some("P")
+        );
+        assert_eq!(
+            nome_da_forma(&receptor(
+                "typescript",
+                "interface P { a: 1 } const p: P = make(); p.foo;"
+            ))
+            .as_deref(),
+            Some("P")
+        );
+    }
+
+    #[test]
+    fn variavel_reatribuida_ou_desestruturada_e_desconhecida() {
+        assert!(
+            nome_da_forma(&receptor(
+                "typescript",
+                "let d = new Date(); d = outro(); d.foo;"
+            ))
+            .is_none()
+        );
+        assert!(nome_da_forma(&receptor("typescript", "const { d } = x; d.foo;")).is_none());
+        assert!(nome_da_forma(&receptor("typescript", "let n = 1; n++; n.foo;")).is_none());
+        // desestruturar um valor TIPADO não devolve o tipo do todo para o pedaço
+        assert!(
+            nome_da_forma(&receptor(
+                "typescript",
+                "const x = new Date(); const { y } = x; y.foo;"
+            ))
+            .is_none()
+        );
+    }
+
+    #[test]
+    fn this_em_classe_de_topo_mas_nao_em_funcao_nem_estatico() {
+        let ok = receptor("typescript", "class K { a = 1; m() { this.foo; } }");
+        assert_eq!(nome_da_forma(&ok).as_deref(), Some("K"));
+        let arrow = receptor("typescript", "class K { m() { [1].map(x => this.foo); } }");
+        assert_eq!(nome_da_forma(&arrow).as_deref(), Some("K"));
+        assert!(
+            nome_da_forma(&receptor(
+                "typescript",
+                "class K { static m() { this.foo; } }"
+            ))
+            .is_none()
+        );
+        assert!(
+            nome_da_forma(&receptor(
+                "typescript",
+                "class K { m() { function g() { this.foo; } } }"
+            ))
+            .is_none()
+        );
+        assert!(
+            nome_da_forma(&receptor("typescript", "const o = { m() { this.foo; } };")).is_none()
+        );
+        // num campo estático, `this` é o construtor da classe, não a instância
+        assert!(
+            nome_da_forma(&receptor("typescript", "class K { static s = this.foo; }")).is_none()
+        );
+    }
+
+    #[test]
+    fn cadeia_de_membros_usa_o_tipo_declarado() {
+        let r = receptor(
+            "typescript",
+            "interface Cfg { nome: string } class K { cfg: Cfg = { nome: 'x' }; m() { this.cfg.foo; } }",
+        );
+        assert_eq!(nome_da_forma(&r).as_deref(), Some("Cfg"));
+    }
+
+    #[test]
+    fn assercao_de_tipo_vale_e_const_nao() {
+        assert_eq!(
+            nome_da_forma(&receptor(
+                "typescript",
+                "interface P { a: 1 } (x as P).foo;"
+            ))
+            .as_deref(),
+            Some("P")
+        );
+        assert!(nome_da_forma(&receptor("typescript", "(x as const).foo;")).is_none());
+    }
+
+    #[test]
+    fn jsdoc_param_e_type_dao_o_tipo_em_javascript() {
+        let src = "/** @typedef {{ a: number }} P */\n/**\n * @param {P} p\n */\nfunction f(p) { p.foo; }\n";
+        assert_eq!(
+            nome_da_forma(&receptor("javascript", src)).as_deref(),
+            Some("P")
+        );
+        let src =
+            "/** @typedef {{ a: number }} P */\n/** @type {P} */\nconst p = make();\np.foo;\n";
+        assert_eq!(
+            nome_da_forma(&receptor("javascript", src)).as_deref(),
+            Some("P")
+        );
+        // sem JSDoc nada é inferido de um parâmetro
+        assert!(nome_da_forma(&receptor("javascript", "function f(p) { p.foo; }")).is_none());
+    }
+}
diff --git a/crates/touring-code/src/vgp/lang/typescript/jsdoc.rs b/crates/touring-code/src/vgp/lang/typescript/jsdoc.rs
new file mode 100644
index 00000000..c943b79f
--- /dev/null
+++ b/crates/touring-code/src/vgp/lang/typescript/jsdoc.rs
@@ -0,0 +1,348 @@
+//! JSDoc types for plain JavaScript: `/** @type {T} */` on a declaration, `@param {T} name` on a
+//! function, `@typedef {Object} Name` with `@property` lines.
+//!
+//! JSDoc type syntax is almost TypeScript's: the text of a tag is wrapped as `type __T = <text>;`
+//! and lowered by the TypeScript grammar. Anything the grammar does not accept (`function(string)`,
+//! `?T`, `Object.<K, V>`) is `None` — fail-closed: no type, no check.
+
+use tree_sitter::Node;
+
+use super::decls::{Decl, Membro, ObjTipo, TipoExpr, baixar_tipo};
+use super::util::texto;
+use crate::vgp::lang::parse;
+
+/// One `@tag {type} rest` of a JSDoc block.
+#[derive(Debug, Clone, PartialEq)]
+pub(super) struct Tag {
+    pub nome: String,
+    pub tipo: Option<String>,
+    pub resto: String,
+}
+
+/// The tags of a `/** … */` comment.
+pub(super) fn tags_do_bloco(comentario: &str) -> Vec<Tag> {
+    let corpo = comentario
+        .trim()
+        .trim_start_matches("/**")
+        .trim_end_matches("*/");
+    let mut tags: Vec<Tag> = Vec::new();
+    for linha in corpo.lines() {
+        let l = linha.trim().trim_start_matches('*').trim();
+        if let Some(depois) = l.strip_prefix('@') {
+            tags.push(tag_da_linha(depois));
+        }
+    }
+    tags
+}
+
+fn tag_da_linha(depois_do_arroba: &str) -> Tag {
+    let fim_do_nome = depois_do_arroba
+        .find(|c: char| c.is_whitespace() || c == '{')
+        .unwrap_or(depois_do_arroba.len());
+    let nome = depois_do_arroba[..fim_do_nome].to_string();
+    let resto = depois_do_arroba[fim_do_nome..].trim_start();
+    match resto.strip_prefix('{').and_then(chaves_balanceadas) {
+        Some((tipo, depois)) => Tag {
+            nome,
+            tipo: Some(tipo.trim().to_string()),
+            resto: depois.trim().to_string(),
+        },
+        None => Tag {
+            nome,
+            tipo: None,
+            resto: resto.trim().to_string(),
+        },
+    }
+}
+
+/// `inner} rest` (after the opening brace) → (`inner`, `rest`), honouring nested braces.
+fn chaves_balanceadas(depois_da_abertura: &str) -> Option<(&str, &str)> {
+    let mut nivel = 1usize;
+    for (i, c) in depois_da_abertura.char_indices() {
+        match c {
+            '{' => nivel += 1,
+            '}' => {
+                nivel -= 1;
+                if nivel == 0 {
+                    return Some((&depois_da_abertura[..i], &depois_da_abertura[i + 1..]));
+                }
+            }
+            _ => {}
+        }
+    }
+    None
+}
+
+/// JSDoc-only type syntax the TypeScript grammar may still swallow with another meaning: the
+/// nullable/non-nullable prefixes, the `*` wildcard, `...T` rest, `T=` optional, closure `function(…)`.
+fn e_jsdocismo(t: &str) -> bool {
+    t.starts_with(['?', '!', '*'])
+        || t.starts_with("...")
+        || t.ends_with('=')
+        || t.starts_with("function")
+        || (t.contains('\n') && t.contains("function"))
+}
+
+/// Lower a JSDoc type text to a [`TipoExpr`] (`None` when the TypeScript grammar rejects it).
+pub(super) fn tipo_do_texto(t: &str) -> Option<TipoExpr> {
+    if t.is_empty() || e_jsdocismo(t) {
+        return None;
+    }
+    let fonte = format!("type __T = {t};");
+    let arvore = parse("typescript", &fonte).ok()?;
+    if arvore.root_node().has_error() {
+        return None;
+    }
+    let alias = arvore.root_node().named_child(0)?;
+    let valor = alias.child_by_field_name("value")?;
+    Some(baixar_tipo(valor, &fonte))
+}
+
+/// The JSDoc block that ends right before the statement owning `no` (whitespace only between).
+pub(super) fn bloco_anterior<'s>(no: Node, src: &'s str) -> Option<&'s str> {
+    let alvo = match no.parent() {
+        Some(p) if p.kind() == "export_statement" => p,
+        _ => no,
+    };
+    let anterior = alvo.prev_sibling()?;
+    if anterior.kind() != "comment" {
+        return None;
+    }
+    let t = texto(src, anterior);
+    let intervalo = src.get(anterior.end_byte()..alvo.start_byte())?;
+    (t.starts_with("/**") && intervalo.trim().is_empty()).then_some(t)
+}
+
+/// `/** @type {T} */` before the declaration statement `decl`.
+pub(super) fn tipo_da_declaracao(decl: Node, src: &str) -> Option<TipoExpr> {
+    let bloco = bloco_anterior(decl, src)?;
+    let t = tags_do_bloco(bloco)
+        .into_iter()
+        .find(|t| t.nome == "type")?;
+    tipo_do_texto(t.tipo.as_deref()?)
+}
+
+/// `@param {T} nome` documented for the parameter `nome` of the function that encloses `param`.
+pub(super) fn tipo_do_parametro(param: Node, nome: &str, src: &str) -> Option<TipoExpr> {
+    let mut f = param.parent();
+    while let Some(n) = f {
+        if is_funcao(n.kind()) {
+            break;
+        }
+        f = n.parent();
+    }
+    let funcao = f?;
+    // the comment sits before the function, or before the declaration that holds it
+    let mut dono = funcao;
+    for _ in 0..4 {
+        if let Some(bloco) = bloco_anterior(dono, src) {
+            return tags_do_bloco(bloco)
+                .into_iter()
+                .filter(|t| t.nome == "param" || t.nome == "arg" || t.nome == "argument")
+                .find(|t| nome_do_param(&t.resto) == nome)
+                .and_then(|t| tipo_do_texto(t.tipo.as_deref()?));
+        }
+        dono = dono.parent()?;
+    }
+    None
+}
+
+fn is_funcao(kind: &str) -> bool {
+    matches!(
+        kind,
+        "function_declaration"
+            | "function_expression"
+            | "function"
+            | "arrow_function"
+            | "method_definition"
+            | "generator_function"
+            | "generator_function_declaration"
+    )
+}
+
+/// `[name=default] description` / `name description` → `name` (dotted sub-properties are not params).
+fn nome_do_param(resto: &str) -> &str {
+    let primeiro = resto.split_whitespace().next().unwrap_or("");
+    let sem_colchetes = primeiro.trim_start_matches('[').trim_end_matches(']');
+    let nome = sem_colchetes.split('=').next().unwrap_or("");
+    if nome.contains('.') { "" } else { nome }
+}
+
+/// `@typedef` blocks at the top level of the file ⇒ declarations by name.
+pub(super) fn typedefs_do_arquivo(raiz: Node, src: &str) -> Vec<(String, Decl)> {
+    let mut out = Vec::new();
+    let mut c = raiz.walk();
+    for no in raiz
+        .named_children(&mut c)
+        .filter(|n| n.kind() == "comment")
+    {
+        let t = texto(src, no);
+        if !t.starts_with("/**") {
+            continue;
+        }
+        let tags = tags_do_bloco(t);
+        for (i, td) in tags.iter().enumerate().filter(|(_, t)| t.nome == "typedef") {
+            if let Some(par) = typedef_decl(td, &tags[i + 1..]) {
+                out.push(par);
+            }
+        }
+    }
+    out
+}
+
+fn typedef_decl(td: &Tag, seguintes: &[Tag]) -> Option<(String, Decl)> {
+    let nome = td.resto.split_whitespace().next()?.to_string();
+    let tipo = td.tipo.as_deref()?;
+    if tipo == "Object" || tipo == "object" {
+        let mut corpo = ObjTipo::default();
+        let props = seguintes
+            .iter()
+            .take_while(|t| t.nome != "typedef")
+            .filter(|t| t.nome == "property" || t.nome == "prop");
+        for p in props {
+            let n = nome_do_param(&p.resto);
+            if !n.is_empty() {
+                corpo.membros.push(Membro {
+                    nome: n.to_string(),
+                    tipo: p.tipo.as_deref().and_then(tipo_do_texto),
+                });
+            }
+        }
+        corpo.aberto = corpo.membros.is_empty();
+        return Some((
+            nome,
+            Decl::Interface {
+                params: Vec::new(),
+                estende: Vec::new(),
+                corpo,
+            },
+        ));
+    }
+    tipo_do_texto(tipo).map(|t| {
+        (
+            nome,
+            Decl::Alias {
+                params: Vec::new(),
+                tipo: t,
+            },
+        )
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn tags_com_tipo_aninhado_e_continuacao() {
+        let tags = tags_do_bloco(
+            "/**\n * Descrição.\n * @param {{ a: number, b: { c: string } }} opts as opções\n * @returns {Promise<void>}\n */",
+        );
+        assert_eq!(tags.len(), 2);
+        assert_eq!(tags[0].nome, "param");
+        assert_eq!(
+            tags[0].tipo.as_deref(),
+            Some("{ a: number, b: { c: string } }")
+        );
+        assert_eq!(tags[0].resto, "opts as opções");
+        assert_eq!(tags[1].tipo.as_deref(), Some("Promise<void>"));
+    }
+
+    #[test]
+    fn tipo_do_texto_aceita_ts_e_rejeita_jsdocismos() {
+        assert!(matches!(
+            tipo_do_texto("{ a: number }"),
+            Some(TipoExpr::Obj(_))
+        ));
+        assert!(matches!(tipo_do_texto("Foo"), Some(TipoExpr::Ref { .. })));
+        assert!(matches!(
+            tipo_do_texto("string[]"),
+            Some(TipoExpr::Array(_))
+        ));
+        assert!(tipo_do_texto("function(string): number").is_none());
+        assert!(tipo_do_texto("?Foo").is_none());
+        assert!(tipo_do_texto("").is_none());
+    }
+
+    #[test]
+    fn nome_do_param_tira_colchetes_default_e_ignora_subpropriedade() {
+        assert_eq!(nome_do_param("opts as opções"), "opts");
+        assert_eq!(nome_do_param("[opts=1] opcional"), "opts");
+        assert_eq!(nome_do_param("opts.sub documenta a subpropriedade"), "");
+    }
+
+    fn arvore(src: &str) -> tree_sitter::Tree {
+        parse("javascript", src).expect("parse")
+    }
+
+    #[test]
+    fn tipo_da_declaracao_com_export_e_comentario_colado() {
+        let src = "/** @type {{ a: number }} */\nconst x = { a: 1 };\n/** @type {Foo} */\nexport const y = 1;\n// comum\nconst z = 1;\n";
+        let t = arvore(src);
+        let raiz = t.root_node();
+        let mut c = raiz.walk();
+        let decls: Vec<_> = raiz
+            .named_children(&mut c)
+            .filter(|n| n.kind() != "comment")
+            .collect();
+        assert!(matches!(
+            tipo_da_declaracao(decls[0], src),
+            Some(TipoExpr::Obj(_))
+        ));
+        assert!(matches!(
+            tipo_da_declaracao(decls[1], src),
+            Some(TipoExpr::Ref { .. })
+        ));
+        assert!(
+            tipo_da_declaracao(decls[2], src).is_none(),
+            "comentário comum não é JSDoc"
+        );
+    }
+
+    #[test]
+    fn tipo_do_parametro_vem_do_param_da_funcao() {
+        let src = "/**\n * @param {Foo} a\n * @param {string} b\n */\nfunction f(a, b) { return a.x + b.length; }\n";
+        let t = arvore(src);
+        // o `a` dentro dos parâmetros
+        let pos = src.find("(a, b)").expect("params") + 1;
+        let param = t
+            .root_node()
+            .descendant_for_byte_range(pos, pos + 1)
+            .expect("nó");
+        let tipo = tipo_do_parametro(param, "a", src);
+        assert!(
+            matches!(tipo, Some(TipoExpr::Ref { ref nome, .. }) if nome == "Foo"),
+            "{tipo:?}"
+        );
+        assert!(
+            matches!(tipo_do_parametro(param, "b", src), Some(TipoExpr::Prim(ref p)) if p == "string")
+        );
+        assert!(tipo_do_parametro(param, "c", src).is_none());
+    }
+
+    #[test]
+    fn typedef_object_com_properties_vira_interface_fechada() {
+        let src = "/**\n * @typedef {Object} Opcoes\n * @property {number} largura\n * @property {string} [titulo]\n */\n\n/** @typedef {{ x: number }} Ponto */\n";
+        let t = arvore(src);
+        let defs = typedefs_do_arquivo(t.root_node(), src);
+        assert_eq!(defs.len(), 2);
+        match &defs[0] {
+            (n, Decl::Interface { corpo, .. }) => {
+                assert_eq!(n, "Opcoes");
+                let nomes: Vec<&str> = corpo.membros.iter().map(|m| m.nome.as_str()).collect();
+                assert_eq!(nomes, vec!["largura", "titulo"]);
+                assert!(!corpo.aberto);
+            }
+            outro => panic!("{outro:?}"),
+        }
+        assert!(matches!(&defs[1], (n, Decl::Alias { .. }) if n == "Ponto"));
+    }
+
+    #[test]
+    fn typedef_object_sem_properties_fica_aberto() {
+        let src = "/** @typedef {Object} Solto */\n";
+        let t = arvore(src);
+        let defs = typedefs_do_arquivo(t.root_node(), src);
+        assert!(matches!(&defs[0], (_, Decl::Interface { corpo, .. }) if corpo.aberto));
+    }
+}
diff --git a/crates/touring-code/src/vgp/lang/typescript/jsx.rs b/crates/touring-code/src/vgp/lang/typescript/jsx.rs
new file mode 100644
index 00000000..98f2e1fa
--- /dev/null
+++ b/crates/touring-code/src/vgp/lang/typescript/jsx.rs
@@ -0,0 +1,186 @@
+//! JSX attribute checks (`prop`): the attribute a component's `Props` — or a React intrinsic element —
+//! does not have.
+//!
+//! Two claims, two strengths. An attribute on a PROJECT component is judged against that component's
+//! `Props` shape, resolved through the project's own declarations; the shape must be closed (an
+//! `extends React.HTMLAttributes<…>` that cannot be followed opens it, and an open shape says
+//! nothing). An attribute on an intrinsic element (`<div …>`) is judged against the union of every
+//! attribute the React types declare — a closed table generated from `@types/react` — and is only
+//! `Incerto`: JSX libraries augment those interfaces (`css=`, `tw=`), so the motor can warn but not
+//! deny. Hyphenated attributes (`data-*`, `aria-*`) are never judged, as in TypeScript.
+
+use tree_sitter::Node;
+
+use super::analise::{Candidato, Verificador};
+use super::decls::{Decl, TipoExpr, VarDecl};
+use super::projeto::ConfigTs;
+use super::tabelas::ATRIBUTOS_REACT;
+use super::tipos::{Origem, Resultado};
+use super::util::{linha, texto};
+use crate::vgp::politica::Alvo;
+
+/// `React.FC<P>` and friends: the types whose first type argument is the props.
+const TIPOS_DE_COMPONENTE: &[&str] = &["FC", "FunctionComponent", "VFC", "VoidFunctionComponent"];
+
+/// Attributes every React element accepts through `JSX.IntrinsicAttributes`.
+const ATRIBUTOS_UNIVERSAIS: &[&str] = &["key", "ref"];
+
+impl<'a, 't> Verificador<'a, 't> {
+    /// Attributes on JSX elements that provably do not exist.
+    pub(super) fn props_ausentes(&self) -> Vec<Candidato> {
+        let react = self.projeto_usa_react();
+        let mut out = Vec::new();
+        for el in self.nos_de_tipo(&["jsx_opening_element", "jsx_self_closing_element"]) {
+            let Some(nome) = el.child_by_field_name("name") else {
+                continue;
+            };
+            if nome.kind() != "identifier" {
+                continue; // `<ns.Comp>`, `<svg:rect>`
+            }
+            let tag = texto(self.src, nome);
+            let (atributos, tem_spread) = atributos_do_elemento(el, self.src);
+            if tag.contains('-') {
+                continue; // custom element
+            }
+            if tag.starts_with(char::is_lowercase) {
+                if react {
+                    self.props_intrinsecas(tag, &atributos, &mut out);
+                }
+            } else if !tem_spread {
+                self.props_de_componente(tag, el, &atributos, &mut out);
+            }
+        }
+        out
+    }
+
+    /// Does the project type JSX as React (so the React attribute table applies)?
+    fn projeto_usa_react(&self) -> bool {
+        let cfg: &ConfigTs = self.mundo.config();
+        let dir = self.arquivo.parent().unwrap_or(std::path::Path::new("."));
+        let fonte_ok = cfg
+            .jsx_import_source
+            .as_deref()
+            .is_none_or(|s| s == "react");
+        let jsx_ok = cfg
+            .jsx
+            .as_deref()
+            .is_none_or(|j| j.starts_with("react") || j == "preserve");
+        fonte_ok && jsx_ok && self.projeto.pacote_instalado(dir, "react")
+    }
+
+    fn props_intrinsecas(
+        &self,
+        tag: &str,
+        atributos: &[(String, Node<'t>)],
+        out: &mut Vec<Candidato>,
+    ) {
+        for (nome, no) in atributos {
+            if nome.contains('-') || ATRIBUTOS_REACT.binary_search(&nome.as_str()).is_ok() {
+                continue;
+            }
+            out.push(Candidato::novo(
+                "prop",
+                nome,
+                linha(*no),
+                Alvo::Incerto,
+                format!(
+                    "`<{tag}>` não tem o atributo `{nome}` nos tipos do React (HTML/SVG/eventos)"
+                ),
+                Vec::new(),
+            ));
+        }
+    }
+
+    fn props_de_componente(
+        &self,
+        tag: &str,
+        el: Node<'t>,
+        atributos: &[(String, Node<'t>)],
+        out: &mut Vec<Candidato>,
+    ) {
+        if self.escopo.resolver_no_topo(el, tag).is_none() {
+            return; // undeclared (the `componente` check owns it) or shadowed by a local binding
+        }
+        let inf = self.inferidor();
+        let Some((decl, ctx)) = inf.funcao_chamavel(tag) else {
+            return;
+        };
+        let Some(tipo) = tipo_das_props(&decl) else {
+            return;
+        };
+        let Resultado::Forma(forma) = self.resolvedor.resolver(&tipo, &ctx, &[], 0) else {
+            return;
+        };
+        if forma.aberta || forma.origem != Origem::Projeto {
+            return;
+        }
+        for (nome, no) in atributos {
+            if nome.contains('-')
+                || ATRIBUTOS_UNIVERSAIS.contains(&nome.as_str())
+                || !forma.nao_tem(nome)
+            {
+                continue;
+            }
+            out.push(Candidato::novo(
+                "prop",
+                nome,
+                linha(*no),
+                Alvo::Projeto,
+                format!(
+                    "o componente `<{tag}>` não tem a prop `{nome}` em `{}`",
+                    forma.nome
+                ),
+                super::util::reais_de(&forma.membros),
+            ));
+        }
+    }
+}
+
+/// The declared props type of a component: first parameter's annotation, `FC<P>`, `forwardRef<El, P>`.
+fn tipo_das_props(decl: &Decl) -> Option<TipoExpr> {
+    match decl {
+        Decl::Funcao { params } => params.first()?.tipo.clone(),
+        Decl::Variavel(v) => tipo_das_props_de_variavel(v),
+        _ => None,
+    }
+}
+
+fn tipo_das_props_de_variavel(v: &VarDecl) -> Option<TipoExpr> {
+    if let Some(t) = v
+        .funcao
+        .as_ref()
+        .and_then(|ps| ps.first())
+        .and_then(|p| p.tipo.clone())
+    {
+        return Some(t);
+    }
+    if let Some(TipoExpr::Ref { nome, args, .. }) = &v.tipo
+        && TIPOS_DE_COMPONENTE.contains(&nome.as_str())
+    {
+        return args.first().cloned();
+    }
+    match &v.embrulho {
+        Some((quem, targs)) if quem == "forwardRef" => targs.get(1).cloned(),
+        _ => None,
+    }
+}
+
+/// The plain attributes of a JSX element (name, node) and whether any attribute is a spread.
+fn atributos_do_elemento<'t>(el: Node<'t>, src: &str) -> (Vec<(String, Node<'t>)>, bool) {
+    let mut atributos = Vec::new();
+    let mut spread = false;
+    let mut c = el.walk();
+    for a in el.children_by_field_name("attribute", &mut c) {
+        match a.kind() {
+            "jsx_attribute" => {
+                if let Some(n) = a.named_child(0)
+                    && n.kind() == "property_identifier"
+                {
+                    atributos.push((texto(src, n).to_string(), n));
+                }
+            }
+            _ => spread = true,
+        }
+    }
+    (atributos, spread)
+}
diff --git a/crates/touring-code/src/vgp/lang/typescript/modulos.rs b/crates/touring-code/src/vgp/lang/typescript/modulos.rs
