+
+def rust_lista(nome: str, itens: list[str], doc: str) -> str:
+    corpo = ",\n    ".join(f'"{i}"' for i in itens)
+    return f"/// {doc}\npub(super) static {nome}: &[&str] = &[\n    {corpo},\n];\n"
