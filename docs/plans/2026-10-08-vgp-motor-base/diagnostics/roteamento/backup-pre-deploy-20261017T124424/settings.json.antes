            "if": "Read(*.sql)",
            "timeout": 10,
            "statusMessage": "Touring: analyzing file context..."
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/touring-hook cli-suggest",
            "timeout": 3,
            "statusMessage": "touring cli-suggest: classifying operation (Rust, in-daemon)..."
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/touring-hook pre-edit",
