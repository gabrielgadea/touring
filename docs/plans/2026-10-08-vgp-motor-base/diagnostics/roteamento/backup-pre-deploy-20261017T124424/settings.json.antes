        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/touring-hook pre-write",
            "if": "Write(*.rs)",
            "timeout": 10,
            "statusMessage": "Touring: speculative validation..."
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/touring-hook pre-write",
            "if": "Write(*.py)",
