        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/skills/loop-engineering/scripts/hooks/loop_outer_effect.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "SendMessage|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/skills/Touring/scripts/hooks/prose_integrity_gate.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/touring-hook post-edit",
            "timeout": 10,
            "statusMessage": "Touring: verifying edit quality..."
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/doc-coverage-gate.sh \"$ARGUMENTS.tool_input.file_path\"",
            "if": "Edit(*.rs)",
            "timeout": 3,
            "statusMessage": "doc-coverage-gate: soft pub-doc check..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/touring-hook post-write",
            "timeout": 10,
            "statusMessage": "Touring: registering new file..."
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/doc-coverage-gate.sh \"$ARGUMENTS.tool_input.file_path\"",
            "if": "Write(*.rs)",
            "timeout": 3,
            "statusMessage": "doc-coverage-gate: soft pub-doc check..."
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
