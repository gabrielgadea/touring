{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_QGATE_TESTS": "0",
    "CLAUDE_QGATE_PARALLEL": "1",
    "CLAUDE_QGATE_CACHE": "1",
    "CLAUDE_QGATE_FAIL_FAST": "5",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT": "1",
    "TRANSFORMERS_VERBOSITY": "error",
    "TOKENIZERS_PARALLELISM": "false",
    "TF_CPP_MIN_LOG_LEVEL": "3",
    "GPU_SERVICE_URL": "http://localhost:8200",
    "GPU_SERVICE_TIMEOUT": "30.0",
    "USE_GPU_SERVICE": "true",
    "TOURING_PROJECT_ROOT": "/home/gabrielgadea/projects/touring",
    "TOURING_PILLAR_INDUCTION_ARMED": "1",
    "TOURING_HOOK_TRACE_FILE": "/home/gabrielgadea/.claude/touring/hook_trace.jsonl",
    "TOURING_WORKSPACE_ROOT": "/home/gabrielgadea/projects/touring",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "65"
  },
  "permissions": {
    "allow": [
      "Bash(touring *)",
      "Bash(update-touring *)",
      "Bash(touring-bootstrap *)",
      "Bash(touring-mcp *)"
    ],
    "deny": [],
    "defaultMode": "auto"
  },
  "model": "opus",
  "enableAllProjectMcpServers": true,
  "skillOverrides": {
    "gemini-live-api-dev": "off",
    "gitnexus-refactoring": "off",
    "gws-events": "off",
    "gws-keep": "off",
    "gws-workflow": "off",
    "gws-workflow-standup-report": "off",
    "gws-workflow-weekly-digest": "off",
    "literature-review": "off",
    "persona-content-creator": "off",
    "persona-customer-support": "off",
    "persona-event-coordinator": "off",
    "persona-hr-coordinator": "off",
    "persona-project-manager": "off",
    "persona-researcher": "off",
    "persona-sales-ops": "off",
    "plannotator-annotate": "off",
    "plannotator-compound": "off",
    "plannotator-last": "off",
    "plannotator-review": "off",
    "plannotator-setup-goal": "off",
    "plannotator-visual-explainer": "off",
    "playwright-cli": "off",
    "scientific-critical-thinking": "off",
    "scientific-writing": "off",
    "touring-file-metadata": "off",
    "touring-query": "off",
    "touring-token-efficient-workflow": "off",
    "touring-wiring-suggest": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/touring-hook pre-read",
            "if": "Read(*.rs)",
            "timeout": 10,
            "statusMessage": "Touring: analyzing file context..."
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/touring-hook pre-read",
            "if": "Read(*.py)",
            "timeout": 10,
            "statusMessage": "Touring: analyzing file context..."
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/touring-hook pre-read",
            "if": "Read(*.ts)",
            "timeout": 10,
            "statusMessage": "Touring: analyzing file context..."
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/touring-hook pre-read",
            "if": "Read(*.tsx)",
            "timeout": 10,
            "statusMessage": "Touring: analyzing file context..."
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/touring-hook pre-read",
            "if": "Read(*.js)",
            "timeout": 10,
            "statusMessage": "Touring: analyzing file context..."
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/touring-hook pre-read",
            "if": "Read(*.jsx)",
            "timeout": 10,
            "statusMessage": "Touring: analyzing file context..."
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/touring-hook pre-read",
            "if": "Read(*.go)",
            "timeout": 10,
            "statusMessage": "Touring: analyzing file context..."
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/touring-hook pre-read",
            "if": "Read(*.java)",
            "timeout": 10,
            "statusMessage": "Touring: analyzing file context..."
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/touring-hook pre-read",
            "if": "Read(*.c)",
            "timeout": 10,
            "statusMessage": "Touring: analyzing file context..."
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/touring-hook pre-read",
            "if": "Read(*.cpp)",
            "timeout": 10,
            "statusMessage": "Touring: analyzing file context..."
          },
