+        // first call's cold start (a LEADING `--timeout N` breaks clap-routed
+        // commands — `touring --timeout 120 memory store …` is `unrecognized
+        // subcommand '120'` — and a trailing one is `unexpected argument`).
+        let mut child = cmd
+            .args(args)
