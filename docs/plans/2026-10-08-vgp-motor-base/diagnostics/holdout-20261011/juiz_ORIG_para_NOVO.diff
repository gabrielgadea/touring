+        nome = texto.split("#ESPERADO=")[1].split()[0]
+        achados.append({"classe": "atributo", "nome": nome, "linha": 1, "severidade": "deny"})
+    if "#NEGA" in texto:
+        achados.append({"classe": "nome", "nome": "x", "linha": 1, "severidade": "deny"})
+    return {"verdict": "deny" if achados else "allow", "findings": achados, "elapsed_ms": 2.0}
