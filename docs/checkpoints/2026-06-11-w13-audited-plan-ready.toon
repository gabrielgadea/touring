checkpoint:
  id: w13-audited-plan-ready
  date: 2026-06-11
  type: post-wave-audit
  scope: kazuba-rust-core W13.1 doc-intel audit + T12.1.2/T12.2.2 planning
  parent: 2026-06-11-master-plan-implementation-complete

purpose: |
  Document W13.1 candle 0.8 audit (4 sub-tasks) and the 2 deferred
  planning ADRs (T12.1.2 async API, T12.2.2 GPU layer). The audit
  captured 244 error locations and 5 distinct error kinds; the
  remediation plan is ready but multi-session (estimated 2-4 sessions
  per the Master Plan W2.3.2+ work).

w13.1_summary:
  w13.1.1_audit:
    status: COMPLETE
    finding: "candle 0.8 API drift is the root cause of the 87+ test target errors. The drift is contained in 244 file:line locations across learning/ (101), rlm/ (77), doc_memory/ (19), doc_generator/ (14), doc_graph/ (13), doc_symbols/ (13), doc_ast/ (5), qa/ (1), lib.rs (2)."
    error_kinds: 5 (E0107, E0277×2, E0283, E0061×2)
    output: notes/doc_intel_test_audit_2026-06-11.md
  w13.1.2_candle_migration:
    status: PLANNED (ADR-0016 + audit document the plan)
    resolution: "candle 0.6 → 0.8 mechanical sed style for Tensor::new, plus manual fixes for E0277 trait bound cases. ~244 sites. Estimated 1-2 sessions."
  w13.1.3_reinclude:
    status: ATTEMPTED + REVERTED
    finding: "Cargo.toml re-inclusion triggered 14 errors (E0107, E0283, E0277, E0061) in consumers. Reverted to keep workspace integrity (14 members, 0 errors). Right approach is multi-session, not comment-toggle."
  w13.1.4_audit_documented:
    status: COMPLETE
    output: notes/doc_intel_test_audit_2026-06-11.md
    remediation_phases:
      - "Phase 1: Audit (DONE in this checkpoint)"
      - "Phase 2: candle 0.8 migration (W13.1.2 follow-up, 1-2 sessions)"
      - "Phase 3: doc_symbols::store + doc_graph::communities modules (0.5-1 session)"
      - "Phase 4: Re-include + validate (0.5-1 session)"

t12.1.2_async_api:
  status: PLANNED (ADR-0024)
  scope: "PyO3 #[pyo3(async)] adapter for BM25Index.search. Tokio runtime setup. Python migration docs. 10K req/s benchmark."
  estimated_effort: 6-9h (~1-2 sessions)
  score_impact: +0.05 (8.95 → 9.0)

t12.2.2_gpu_layer:
  status: PLANNED (ADR-0025)
  scope: "GpuOps trait + CPU/CUDA/Embeddings backends. Consumer migration. Bench harness."
  estimated_effort: 10-12h (~2-3 sessions)
  score_impact: +0.05 (8.95 → 9.0)

validation_gates_post_w13_audit:
