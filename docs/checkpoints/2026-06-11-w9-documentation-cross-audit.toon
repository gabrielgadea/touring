      severity: pre_existing
      files: ["examples/02_citation_graph.rs", "examples/04_doc_generation.rs"]
      content: "unresolved import `kazuba_rust_core::error::KazubaResult` (May 18 timestamps, before W9)"
      resolution: "Out of W9 documentation audit scope (L135 bounded audit discipline). cargo check --workspace passes (0 errors, excludes examples). Defer to v3.2.0 example refactor."

