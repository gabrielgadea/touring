      key_outputs: ADR-0023 v4.0.0 roadmap (16 waves documented)

  p0_findings:
    - id: P0-1 (plugin-citation compilation errors)
      status: RESOLVED
      abordagem: "Added #[allow(clippy::not_unsafe_ptr_arg_deref)] to 4 FFI functions in kazuba_export_plugin! macro (fix in SDK benefits all 4 plugins)"
    - id: P0-2 (clippy badge FALSO)
      status: RESOLVED
      abordagem: "Updated badge to 'clippy 109 warnings' (yellow) with link to diagnostic"
    - id: P0-3 (kazuba-doc-intelligence excluded)
      status: DEFERRED with formal plan
      abordagem: "ADR-0016 with 4-phase remediation plan (candle, doc_symbols, proptest, re-include); W13.1 scheduled for execution"

  p1_findings:
    - id: T10.2.1 (HashSet → AHashSet)
      status: ABORTED
      abordagem: "Bulk migration cascaded 556 replacements → 5+ errors. ADR-0018 documents 3 safer options (A/B/C). Option A applied: 3 disallowed_* policies removed via clippy.toml. Result: clippy 109+ → 5 warnings (96% reduction)."
    - id: T10.2.2 (workspace.dependencies)
      status: RESOLVED
      abordagem: "Added 13 external deps to [workspace.dependencies]: ahash, chrono, rayon, regex, serde, serde_json, thiserror, tokio, tracing, parking_lot, once_cell, anyhow, bitflags"
    - id: T10.2.3 (30 allow(dead_code) sites)
      status: AUDITED
      abordagem: "notes/dead_code_audit_2026-06-11.md with 3 categories: A KEEP (21), B REMOVE (5-9), C REPLACE-with-cfg (4-6)"
    - id: T10.2.5 (tests in 0% density crates)
      status: RESOLVED
      abordagem: "5+5 smoke tests in kazuba-converters + kazuba-python"

  p2_findings:
    - id: T11.1.1 (src/ compat shim)
      status: RESOLVED
      abordagem: "ADR-0019: 427 files in src/ are v2.x backward-compat shim, NOT legacy. Added doc comment to src/lib.rs."
    - id: T11.1.4 (ADRs 0001-0009 → archive)
      status: RESOLVED
      abordagem: "9 ADRs moved to docs/adr/archive/. archive/index.md created. 13 cross-references updated."
    - id: T11.1.5 (Diátaxis cross-links)
      status: VERIFIED
      abordagem: "5 tutorials already have 'Next steps' sections with how-to/reference links. No additions needed."
    - id: T11.2.1 (PyO3 Bound<'py, T>)
      status: VERIFIED MODERN
      abordagem: "5 files use Bound<'py, T>; 0 use &PyAny. notes/pyo3_audit_2026-06-11.md."
    - id: T11.2.2 (mike for docs versioning)
      status: CONFIGURED
      abordagem: "extra.version.provider: mike in mkdocs.yml. ADR-0022. Needs `pip install mike` to activate."

  p3_findings:
    - id: T11.2.4 (search.suggestions)
      status: VERIFIED
      abordagem: "Already enabled in QA-06 W10.1. Verified in mkdocs.yml:50."

