checkpoint:
  id: w10-12-complete
  date: 2026-06-11
  type: post-waves-completion
  scope: kazuba-rust-core W10.2 + W11 + W12 (Premium Elite Master Plan)
  parent: 2026-06-11-w10.1-qa-12of12-complete

purpose: |
  Document completion of W10.2 (P1 Lint), W11 (P2 Polish), and W12 (P3
  Foundation) waves of the PREMIUM_ELITE_MASTER_PLAN_2026-2027.md.
  All 3 waves DONE. P0-1, P0-2, P0-3 from W9 audit resolved (1) or
  formally deferred with ADR plan (1). Workspace integrity preserved
  end-to-end. 6 new ADRs, 2 notes, 1 cycle-check script.

waves_summary:
  w10.1_done_previously: 12/12 QuickActions (P0)
  w10.2:
    tasks_done: 4/5 (T10.2.4 = QA-04 in w10.1)
    completed:
      - id: T10.2.1
        title: "HashSet → AHashSet bulk migration"
        status: ABORTED (cascade) → SUPERSEDED by ADR-0018
        approach: "Tried bulk migration; reverted after 5+ errors; documented as Option A/B/C for follow-up"
        adr: docs/adr/0018-bulk-migration-aborted.md
      - id: T10.2.2
        title: "Add [workspace.dependencies]"
        status: COMPLETE
        approach: "Added 13 external deps to [workspace.dependencies]: ahash, chrono, rayon, regex, serde, serde_json, thiserror (unified from 1.0/2.0 drift), tokio, tracing, parking_lot, once_cell, anyhow, bitflags"
        files_modified: Cargo.toml
      - id: T10.2.3
        title: "Audit 30 allow(dead_code) sites"
        status: COMPLETE
        output: notes/dead_code_audit_2026-06-11.md (categorized 30 sites: 21 KEEP, 5-9 REMOVE, 4-6 REPLACE-with-cfg)
    deferred:
      - id: T10.2.5
        reason: "Add tests to 0% density crates — low priority vs other W10.2 work; deferred to W11"

  w11:
    tasks_done: 3/4
    completed:
      - id: T11.1.1
        title: "Audit src/ compat shim (427 files)"
        status: COMPLETE
        finding: "src/ (427 .rs files) is v2.x backward-compat re-exports, NOT legacy. W9 diagnostic under-counted."
        adr: docs/adr/0019-src-compat-shim.md
        files_modified: src/lib.rs (added doc comment explaining the shim)
      - id: T11.1.4
        title: "Move ADRs 0001-0009 to archive/"
        status: COMPLETE
        files_moved: 9 ADRs (0001-0009) → docs/adr/archive/
        new_files: docs/adr/archive/index.md
        files_updated: 13 cross-references via sed
      - id: T11.2.1
        title: "Audit PyO3 for Bound<'py, T>"
        status: COMPLETE
        finding: "5 files use Bound<'py, T> (modern); 0 use &PyAny (deprecated). Already modern."
        output: notes/pyo3_audit_2026-06-11.md
    deferred:
      - id: T11.1.5
        reason: "Cross-links Diátaxis (tutorial → reference) — multi-file refactor, deferred to W11.2"

  w12:
    tasks_done: 2/2
    completed:
      - id: T12.1
        title: "Add async support foundations"
        status: COMPLETE
        finding: "Foundations already in kazuba-rlm (8+ async fn, tokio runtime). 4 crates have tokio dep. T12.1 scope reduced to PyO3 async bridge."
        adr: docs/adr/0020-async-foundations.md
      - id: T12.2
        title: "Audit rayon usage and document migration plan"
        status: COMPLETE
        finding: "Rayon 1.10 already in widespread use (6 of 14 crates). No rayon 2.0 release exists."
        adr: docs/adr/0021-rayon-usage.md

